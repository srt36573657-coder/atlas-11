# ATLAS 11 환경변수 본보기 — 복사해서 쓴다: sudo cp deploy/atlas11.env.example /etc/atlas11.env  (Docker 는 deploy/atlas11.env)
# 값은 전부 자리표시(비어 있음)다. 진짜 값은 여기 파일이 아니라 복사한 파일에만 적고, 그 파일은 git 에 넣지 않는다.
# 정규장 종가 수집기(collect_krx_close.mjs · 야후 차트)는 열쇠(키)가 필요 없다 — 아래 KRX/NAVER 열쇠는 앞으로 다른 원천을 붙일 때를 위한 자리다. 비워 두어도 매일 실행은 돈다.
KRX_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
FRED_API_KEY=
# Netlify 자동 배포(GitHub Actions 의 마지막 단계)에만 쓴다. 비어 있으면 그 단계는 건너뛴다.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# 예약 실행기(scheduler.mjs) 조정값 — 보통은 손대지 않는다
# ATLAS_RUN_KST=16:00
# ATLAS_RETRY_MINUTES=10
# ATLAS_GIVE_UP_KST=18:00
# ATLAS_DAILY_CMD=node scripts/atlas11/run_daily.mjs --collector scripts/atlas11/collect_krx_close.mjs
# 네트워크 없이 시험할 때만: 합성 fixture 를 응답으로 쓴다(실제 시세 아님)
# ATLAS_COLLECTOR_FIXTURE=tests/atlas11/fixtures/collector
