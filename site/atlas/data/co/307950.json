ev":[30650,37136,42521],"op":[1814,2244,2553],"net":[1403,1752,1868],"roe":[9.01,10.4,10.27],"debt":[78.55,93.55,92.31]},"per":52.18,"pbr":5.26,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[30650,37136,42521,48404],"baseYear":"2025","baseRev":42521,"ind":{"name":"IT서비스","n":29,"rank":1,"share":24.2,"near":2,"gap12":1.31},"top":[["현대오토에버",42521,"307950"],["NICE",32426,"034310"],["NHN",25162,"181710"],["KG이니시스",13589,"035600"],["NHN KCP",12349,"060250"]],"story":{"shape":"혼자 앞섬","h":{"1":{"lo":1.08,"mid":1.19,"hi":1.31,"t":"그룹 전산을 새로 바꾸는 일감이 이어져 꾸준히 커지는 쪽에 가깝습니다.","g":"아주 높다"},"3":{"lo":1.09,"mid":1.33,"hi":1.62,"t":"그룹이 관세로 돈을 아끼면 차량 소프트웨어 쪽은 더디지 않을까요?","g":"아주 높다"},"5":{"lo":1.12,"mid":1.46,"hi":1.9,"t":"그룹 일감 안에서는 사실상 혼자라 천천히 느려지는 쪽에 가깝습니다.","g":"아주 높다"},"10":{"lo":1.2,"mid":1.78,"hi":2.62,"t":"그룹 밖 손님이 늘지 않으면 그룹이 크는 만큼만 크는 쪽에 가깝습니다.","g":"아주 높다"}},"brk":"현대차그룹이 전산 · 소프트웨어 일을 다른 회사에 나눠 맡기는 일.","teams":{"google":"매출이 2023년 3조650억 원에서 2025년 4조2,521억 원으로 2년 새 39% 늘었습니다.","apple":"2025년 그룹 전산을 새로 짓는 일(SI) 매출이 29.6% 늘어 가장 빨리 컸습니다.","claude":"그룹 일에 크게 기대어, 그룹이 돈을 아끼면 바로 덜 크지 않을까요?"},"rivals":[{"name":"Vector","where":"유럽","note":"차 안 제어기에 들어가는 기본 소프트웨어로 다툼","url":""},{"name":"삼성SDS","where":"국내","note":"큰 회사 전산 시스템 · 클라우드 일감으로 다툼(그룹 밖 일감)","url":""},{"name":"LG CNS","where":"국내","note":"큰 회사 전산 시스템 · 클라우드 일감으로 다툼(그룹 밖 일감)","url":""}],"sells":"현대차 · 기아 등 현대차그룹 회사에 전산 시스템을 지어 주고(SI) 맡아서 돌려 줍니다(ITO). 차 안 제어기에 들어가는 기본 소프트웨어 「모빌진」과 순정 내비게이션도 만들어 그룹 차 회사에 팝니다.","why":"현대차그룹 계열이어서 그룹의 전산 · 차량 소프트웨어 일을 맡기 쉽습니다(그룹 일감 안에서는 사실상 혼자). 거꾸로 그룹이 돈을 아끼면 바로 영향을 받습니다(2025년 차량 SW 매출은 2.9%만 늘어남).","market":"그룹 회사들이 판매 · 경영 관리(ERP) · 고객센터 시스템을 새로 바꾸고 있어 일감은 커지는 쪽입니다(2025년 SI 매출 29.6% 늘어남). 차량 소프트웨어는 관세에 따른 원가 줄이기로 더디게 늘었습니다.","events":"2025년 현대차 국내 판매 시스템, 북미 · 유럽 · 아태 차세대 ERP, 기아 차세대 고객센터 시스템 일을 따냈습니다. 미국 관세 부담으로 그룹 차의 순정 내비게이션 탑재가 줄었습니다.","facts":[{"text":"2025년 매출은 4조2521억원으로 14.5% 늘었고, 영업이익은 2553억원으로 13.8% 늘었습니다.","url":"https://news.bizwatch.co.kr/article/mobile/2026/01/30/0030","date":"2026-01-30"},{"text":"SI 부문이 29.6% 늘어 가장 빨리 컸고, 현대차 판매 시스템 · 차세대 ERP · 모셔널 클라우드 · 기아 고객센터 일이 보탬이 됐습니다.","url":"https://news.bizwatch.co.kr/article/mobile/2026/01/30/0030","date":"2026-01-30"},{"text":"차량 SW 부문은 2.9% 느는 데 그쳤고, 미국 관세 부담에 따른 원가 절감으로 순정 내비게이션 탑재가 줄어든 영향이 컸습니다.","url":"https://news.bizwatch.co.kr/article/mobile/2026/01/30/0030","date":"2026-01-30"},{"text":"ITO 부문은 8.4% 늘었고, 그룹 계열사 IT와 커넥티드카 서비스(CCS) 운영 매출이 이끌었습니다.","url":"https://news.bizwatch.co.kr/article/mobile/2026/01/30/0030","date":"2026-01-30"}],"unknown":"그룹 밖 매출 비중 숫자, 차량 소프트웨어 시장 점유율, 2026년 회사 계획은 못 찾았습니다. 경쟁 회사는 열어 본 글에 없어 업계에 알려진 이름으로 적었습니다. 2026년 1분기 영업이익이 20.7% 줄었다는 기사(헤럴드경제, 2026-04-30)는 제목만 보고 본문은 열지 못했습니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
