720,2715,2760,2840,2880,3000,2960,3020,3120,3040,3065,3050,2860,2875,2515,2480,2430,2440,2540,2560,2540,2510,2615,2570,2600,2600,2595,2620,2510,2510,2490,2485,2450,2440,2465,2400,2425,2415,2400,2370,2420,2400,2390,2415,2420,2395,2385,2370,2370,2350,2305],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[947,1071,1195],"op":[89,165,191],"net":[67,122,201],"roe":[18.92,25.42,32.19],"debt":[90.88,86.25,70.37]},"per":6.29,"pbr":1.66,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[947,1071,1195,null],"baseYear":"2025","baseRev":1195,"ind":{"name":"교육","n":22,"rank":11,"share":2.7,"near":8,"gap12":1.11,"size":"rev","me":1195},"top":[["메가스터디교육",8849,"215200"],["웅진씽크빅",7974,"095720"],["대교",6500,"019680"],["멀티캠퍼스",3308,"067280"],["비상교육",2688,"100220"]],"story":{"shape":"혼자 앞섬","h":{"1":{"lo":0.94,"mid":1.05,"hi":1.2,"t":"의대 정원이 다시 줄어 편입 자리가 늘던 흐름이 꺾일까요?","g":"높다"},"3":{"lo":0.86,"mid":1.08,"hi":1.36,"t":"매출의 78%가 편입이어서 크게 늘기는 어렵지 않을까요?","g":"높다"},"5":{"lo":0.8,"mid":1.11,"hi":1.5,"t":"미용 · 직업 학원이 조금씩 받쳐 주는 쪽에 가깝습니다.","g":"반반"},"10":{"lo":0.65,"mid":1.15,"hi":1.9,"t":"편입 손님이 크게 늘기 어려워 10년 뒤도 조금 큰 쪽에 가깝습니다.","g":"반반"}},"brk":"의대 정원이 줄어 대학을 떠나는 학생이 줄고 편입 자리가 크게 줄면 매출이 범위 아래로 갑니다.","teams":{"google":"2025년 매출 1,195억 원은 교육 상장사 22곳 가운데 11위(몫 2.7%)이고, 2026년 증권사 평균치는 없습니다.","apple":"2024년 매출의 78.1%(836억 원)가 편입 부문이고, 누적 편입 합격생이 23만 4천 명이라고 소개됩니다.","claude":"2025년 매출에는 그해 1월 사들인 뷰티르샤(2023년 매출 110억 원)가 더해져, 스스로 큰 몫은 보이는 것보다 작을 수 있습니다."},"rivals":[{"name":"해커스편입","where":"국내","note":"온라인 · 오프라인 편입 강의와 모의고사로 같은 편입 준비생을 두고 다툰다.","url":"https://magazine.hankyung.com/business/article/202008253742b"},{"name":"멀티캠퍼스","where":"국내","note":"AI · 소프트웨어 같은 IT 직업훈련 과정으로 취업 교육 쪽에서 다툰다.","url":"","chk":{"v":"기사로 확인","url":"https://m.boannews.com/html/detail.html?idx=114155"}}],"sells":"대학 편입 시험을 준비하는 학생에게 '김영편입' 학원 수업과 인터넷 강의를 판다. 취업 교육 쪽에서는 미용 학원(메가뷰티아카데미 · MBC뷰티아카데미)과, 나라가 비용을 대는 IT 직업훈련 학원(더조은컴퓨터아카데미 · 메가스터디아카데미)을 운영한다. 손님은 편입 준비생과 미용 · IT 일을 배우려는 사람이다.","why":"편입 쪽은 서울 · 수도권을 중심으로 전국 최대 규모의 종합반 학원을 두고, 누적 편입 합격생이 23만 4천 명이라 오래 쌓은 이름이 있다. 대학 편입 교육 회사 가운데 유일하게 상장한 회사이고 메가스터디교육 계열이다. 약점은 매출의 약 78%가 편입 한 가지에 몰려 있어, 대학 편입 자리 수가 줄면 흔들릴 수 있다는 점이다.","market":"의대 정원이 늘었을 때 학생들이 다시 수능을 보려고 대학을 떠나, 2025학년도 주요 대학 편입 자리가 크게 늘었고 2026학년도 의약계열 편입 자리도 늘었다. 다만 2026학년도 의대 모집은 3,123명으로 1년 전보다 1,487명 줄어, 편입 자리가 늘던 흐름이 이어질지는 알 수 없다.","events":"2025년 1월 MBC뷰티아카데미(전국 23개 점포)를 운영하는 뷰티르샤의 지분 100%를 사들여 미용 학원을 넓혔다. 2026년 3월 회사 합병을 결정해 6월에 마쳤다는 공시가 있으나 합병 상대는 확인하지 못했다. 김영편입은 2026년 초 2027학년도 의약대 편입 준비 과정을 열었다.","facts":[{"text":"김영편입은 메가스터디교육 계열 아이비김영의 대학 편입 브랜드다. 강남 · 신촌 · 노량진 · 부평 · 수원 · 평촌 · 대구 · 대전 · 부산 학원과 인터넷 강의로 편입 준비생을 가르치며, 누적 편입 합격생이 23만 4천 명이라고 소개됐다.","url":"https://magazine.hankyung.com/business/article/202410295546b","date":"2024-11-05","chk":"맞음"},{"text":"2024년 매출은 편입 부문이 836억 원(전체의 78.1%), 미용 학원이 속한 취업 부문이 233억 원(21.9%)이었다. 2025년 1월 MBC뷰티아카데미를 운영하는 뷰티르샤(전국 23개 점포, 2023년 매출 110억 원)의 지분 100%를 사들였다.","url":"https://biz.newdaily.co.kr/site/data/html/2025/03/24/2025032400129.amp.html","date":"2025-03-24","chk":"맞음"},{"text":"대학 편입 교육 시장의 유일한 상장 회사로 소개된다. 편입 부문은 서울 · 수도권 중심으로 전국 최대 규모의 종합반 학원과 연고대 · 의약대 전문관을 두고, 취업 교육 부문은 전국 27개 미용 학원과 AI · 빅데이터 · 반도체 설계 같은 나라 지원 직업훈련(더조은컴퓨터아카데미 · 메가스터디아카데미)을 운영한다.","url":"https://valueline.co.kr/finance/summary/339950","date":"","chk":"맞음"},{"text":"의대 정원이 늘자 의대를 노린 학생들이 다시 수능을 보려고 대거 빠져나가, 2025학년도 주요 대학 편입 모집 인원이 크게 늘었다(홍익대 64명→190명, 인하대 129명→217명 등).","url":"https://www.localnaeil.com/News/View/652377","date":"2025-01-23","chk":"맞음"},{"text":"2026학년도 의약계열 편입 모집은 늘었다. 의학과는 85명으로 1년 전의 2배가 넘어 역대 최대였고, 약학과는 302명으로 45.2% 늘었다. 김영편입은 강남 · 신촌 의약대 편입관에서 2027학년도 준비 과정을 열었다.","url":"https://www.twig24.com/news/2026/02/09/20260209500268","date":"2026-02-09","chk":"맞음"},{"text":"2026학년도 39개 의대의 모집 인원은 3,123명으로 2025학년도보다 1,487명 줄었다.","url":"https://www.segye.com/newsView/20250728504071","date":"2025-07-28","chk":"맞음"}],"unknown":"편입 시장 전체 크기와 회사별 몫(%)은 못 찾았다. 2022년 한국경제 기사 제목이 아이비김영을 '1위'라고 불렀지만 기사를 열지 못해 내용을 확인하지 못했다. 2026년 합병 상대 회사, 2026년 상반기 실적, 뷰티르샤를 사들인 값, 의대 정원이 다시 줄어든 뒤의 편입 자리 변화도 확인하지 못했다. 미용 · IT 학원 쪽 경쟁 회사는 기사에서 찾지 못해 업계에 알려진 이름으로 적었다.","webFacts":6,"file":"reports/atlas11/t365/grow/stories-20261014T0826Z.json","made":"2026-10-14"}}}
