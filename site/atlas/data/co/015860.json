0,5420,5480,5580,5940,5820,5730,5380,5010,4980,5700,5630,5900,6190,6250,6340,6470,6570,6800,6720,6950,6700,6740,6690,6340,6950,6780,6870,6980,6870,6710,6670,6360,6370,6510,6670,6670,6860,6870,6840,6990,6780,6790,6800,7010,6870,6960,6990,7060,6880,7060,7180,7400,7260,7150,7070],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[14719,18000,22827],"op":[575,725,1456],"net":[479,504,896],"roe":[6.24,4.95,7.12],"debt":[77.51,88.42,103.38]},"per":null,"pbr":0.51,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[14719,18000,22827,null],"baseYear":"2025","baseRev":22827,"ind":{"name":"전선·전기장비","n":14,"rank":4,"share":4.9,"near":3,"gap12":8.77,"size":"rev","me":22827},"top":[["LS",318700,"006260"],["대한전선",36360,"001440"],["가온전선",25457,"000500"],["일진홀딩스",22827,"015860"],["일진전기",20446,"103590"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":1.03,"mid":1.21,"hi":1.4,"t":"주력 일진전기의 일감이 2029년 물량까지 차 있어 조금 더 크는 쪽에 가깝습니다.","g":"아주 높다"},"3":{"lo":0.98,"mid":1.33,"hi":1.78,"t":"매출의 약 90%가 일진전기라 그 회사 속도를 따라가는 쪽에 가깝습니다.","g":"아주 높다"},"5":{"lo":0.9,"mid":1.38,"hi":2.0,"t":"경쟁 회사 증설이 끝나면 변압기 값이 내려가지 않을까요?","g":"높다"},"10":{"lo":0.78,"mid":1.5,"hi":2.55,"t":"수소탱크 회사는 현대차그룹 한 곳에 기대어 보탬이 적지 않을까요?","g":"높다"}},"brk":"주력 일진전기의 변압기 · 전선 주문이 2029년 전에 크게 줄면 이 판단은 틀립니다.","teams":{"google":"2025년 영업이익은 1456억 원으로, 1년 전 725억 원의 두 배쯤입니다.","apple":"변압기 · 전선의 일진전기와 인조 다이아몬드 · 수소탱크 회사를 거느린 지주회사입니다.","claude":"수소탱크 회사 일진하이솔루스는 2025년 매출 816억 원에 112억 원 적자였습니다."},"rivals":[{"name":"HD현대일렉트릭","where":"국내","note":"자회사 일진전기와 초고압 변압기로 다툰다.","url":"https://v.daum.net/v/20251106175648961"},{"name":"효성중공업","where":"국내","note":"자회사 일진전기와 초고압 변압기로 다툰다.","url":"https://v.daum.net/v/20251106175648961"},{"name":"Hexagon Composites","where":"유럽","note":"노르웨이 회사. 손자회사 일진하이솔루스와 수소탱크로 다툰다.","url":"https://alphadistill.com/report/302"}],"sells":"직접 물건을 만들기보다 자회사를 거느린 지주회사다. 매출의 약 90%는 변압기·전선을 파는 일진전기에서 나오고(2025년 일진전기 매출 2조446억원, 일진홀딩스 2조2827억원), 그 밖에 인조 다이아몬드(일진다이아)와 수소차 수소탱크(일진하이솔루스)가 있다.","why":"주력인 일진전기가 전선과 변압기를 함께 가져 한 번에 맡길 수 있다는 점이 강점이다. 약점은 수소탱크 회사가 적자이고 매출 80% 이상을 현대차그룹 한 곳에 기댄다는 점이다.","market":"변압기·전선 시장은 커지는 쪽이다(일진전기 공장 가동률 85% 넘음). 수소탱크 매출은 2024년 793억원에서 2025년 816억원으로 거의 제자리다.","events":"일진전기의 미국 동부 전력망 4300억원 계약이 2026년부터 공급 · 일진하이솔루스 2026년 3월 독일 법인 설립과 대표 교체 · 2025년 새 넥쏘에 수소탱크를 혼자 댐.","facts":[{"text":"일진홀딩스는 일진전기 47.76%, 일진다이아 50.07%, 일진디앤코 100%를 가진 지주회사다.","url":"https://alphadistill.com/report/981","date":"2026-04-28"},{"text":"일진하이솔루스(수소탱크)는 2025년 매출 816억원, 영업손실 112억원이었고, 매출 80% 이상을 현대차그룹에 기댄다.","url":"https://alphadistill.com/report/302","date":"2026-04-02"},{"text":"주력 자회사 일진전기의 홍성 변압기 공장 가동률은 85%를 넘었고, 수주잔고는 1조7000억원 이상이다.","url":"https://v.daum.net/v/20251106175648961","date":"2025-11-06"}],"unknown":"지주회사 연결 기준 사업별 매출 비중의 원문 숫자 · 일진디앤코가 하는 일 · 입력 자료에 적힌 자동차 엔진 부품·개폐기 사업이 지금도 있는지.","webFacts":3,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
