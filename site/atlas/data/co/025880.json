485,2460,2460,2490,2500,2510,2530,2555,2555,2605,2660,2615,2625,2605,2450,2390,2390,2370,2365,2360,2365,2370,2370,2385,2390,2380,2345,2355,2375,2360,2375,2370,2345,2350,2365,2345,2335,2350,2310,2310,2305,2295,2300,2305,2315,2315,2310,2340,2355,2290,2315],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[926,1030,1218],"op":[60,81,122],"net":[67,70,106],"roe":[10.51,9.99,13.66],"debt":[49,43.54,23.84]},"per":3.73,"pbr":0.44,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[926,1030,1218,null],"baseYear":"2025","baseRev":1218,"ind":{"name":"사료·축산","n":17,"rank":12,"share":1.1,"near":5,"gap12":1.79,"size":"rev","me":1218},"top":[["이지홀딩스",33889,"035810"],["선진",18957,"136490"],["팜스토리",14559,"027710"],["하림",14400,"136480"],["이지바이오",4769,"353810"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.82,"mid":1.01,"hi":1.24,"t":"2026년 상반기 매출이 한 해 전과 비슷해 제자리에 가까울까요?","g":"반반"},"3":{"lo":0.76,"mid":1.04,"hi":1.38,"t":"곡물 값과 환율에 따라 매출이 크게 오르내리는 쪽에 가깝습니다.","g":"반반"},"5":{"lo":0.7,"mid":1.07,"hi":1.5,"t":"농협 · 카길 같은 큰 회사 사이에서 몫을 늘리기는 어렵지 않을까요?","g":"반반"},"10":{"lo":0.6,"mid":1.15,"hi":1.85,"t":"몸집이 작아 10년 뒤에도 지금 크기 근처일 쪽에 가깝습니다.","g":"반반"}},"brk":"곡물 값이나 환율이 크게 움직이면 사료 값이 함께 바뀌어 매출이 범위 밖으로 나갈 수 있습니다.","teams":{"google":"사료 · 축산 상장 17곳 가운데 매출 12위(몫 1.1%)이고, 2026년 증권사 평균치는 없습니다.","apple":"돼지 · 닭 · 소와 애완동물 사료를 만들어 농가에 대고, 2025년 회사 혼자 기준 매출은 1,204억 원입니다.","claude":"매출이 2023년 926억 원에서 2025년 1,218억 원으로 빨리 늘어, 제자리로 본 것이 너무 어둡게 본 셈일 수도 있지 않을까요?"},"rivals":[{"name":"농협사료","where":"국내","note":"가축용 배합사료 전반으로 다툰다. 2017년 기사에서 '농협'이 국내 사료 시장 1위로 소개됐다.","url":"https://www.koreatimes.co.kr/amp/business/companies/20170514/cargill-to-build-5th-feed-mill-in-korea"},{"name":"카길(Cargill)","where":"미국","note":"국내에서 배합사료를 만들어 판다. 2017년 기사에서 농협 · 하림 다음 국내 3위 사료 생산 회사로 소개됐다.","url":"https://www.koreatimes.co.kr/amp/business/companies/20170514/cargill-to-build-5th-feed-mill-in-korea"},{"name":"팜스코","where":"국내","note":"닭 · 돼지에 먹이는 배합사료로 다투고, 고기 가공 일도 한다(2024년 기사).","url":"https://www.newstomato.com/ReadNews.aspx?no=1221031"}],"sells":"가축이 먹는 배합사료(여러 곡물과 영양분을 섞어 만든 먹이)를 만들어 돼지 · 닭 · 소를 기르는 농가에 판다. 애완동물 사료도 만들고, 사료 말고 식품 · 비료 일도 함께 한다. 자회사로 농업회사법인 케이씨팜(지분 84.7%)과 케이씨대부파이낸스(돈을 빌려주는 회사, 지분 100%)를 둔다.","why":"1970년에 세워져 50년 넘게 사료를 만들어 온 회사로, 돼지 · 닭 · 소 · 애완동물 사료를 두루 갖췄다. 약점은 크기가 작다는 점이다. 국내 사료 · 축산 상장사 17곳 가운데 매출 12위(몫 약 1.1%)이고, 원료인 옥수수 · 대두박(콩에서 기름을 짜고 남은 것) 값과 환율에 따라 이익이 흔들린다.","market":"한국은 세계 9번째로 큰 가축 사료 시장이고, 농협이 1위, 하림 · 카길이 그 뒤를 잇는다(2017년 기사). 사료 회사 이익은 곡물 값에 크게 달려 있다. 러시아-우크라이나 전쟁으로 곡물 값이 뛰자 여러 사료 회사가 2022년에 적자를 냈고, 2023년에는 많은 곳이 회복했다(2024년 기사).","events":"2025~2026년 큰 투자 · 계약 · 새 제품 소식은 찾지 못했다. 2025년 매출은 1,218억 원으로 한 해 전(1,030억 원)보다 늘었다. 2026년 2분기 매출은 289억 원으로, 한 해 전 같은 때(321억 원)보다 줄었다.","facts":[{"text":"케이씨피드는 배합사료(여러 곡물과 영양분을 섞은 가축 먹이)를 만드는 국내 축산 회사다. 돼지 · 닭 같은 가축용 배합사료를 만들어 농가에 공급한다.","url":"https://etfshopping.com/stock/025880","date":"","chk":"맞음"},{"text":"가축용 배합사료를 만들어 공급 · 유통한다. 닭 · 돼지 · 소 같은 가축 사료와 애완동물 사료를 만들고, 사료 말고도 식품과 비료 사업을 함께 한다.","url":"https://financialfilings.com/companies/kc-feed-co-ltd/","date":"","chk":"맞음"},{"text":"본사는 경북 영천시 금호읍에 있고 1970년 5월 6일 세워졌다. 자회사로 농업회사법인 케이씨팜(지분 84.7%)과 케이씨대부파이낸스(지분 100%)를 둔다. 2025년 회사 혼자 기준(별도) 매출은 1,204억 원이다.","url":"https://etfshopping.com/stock/025880/company","date":"2026-08-10","chk":"맞음"},{"text":"한국은 세계 9번째로 큰 가축 사료 시장이다. 국내 1위는 농협이고, 카길은 농협 · 하림 다음 3위 사료 생산 회사다.","url":"https://www.koreatimes.co.kr/amp/business/companies/20170514/cargill-to-build-5th-feed-mill-in-korea","date":"2017-05-14","chk":"맞음"},{"text":"배합사료 회사들은 주 원료인 옥수수 · 대두박(콩에서 기름을 짜고 남은 것) 값의 변화에 민감하다. 러시아-우크라이나 전쟁으로 곡물 값이 뛰자 판매 값을 올렸지만, 환율 · 인건비 · 운반비도 함께 올라 모자랐다.","url":"https://www.newstomato.com/ReadNews.aspx?no=1221031","date":"2024-02-27","chk":"맞음"},{"text":"2026년 1분기 매출은 277억 원(영업이익 16억 원), 2분기 매출은 289억 원(영업이익 28억 원)이다. 한 해 전 같은 때는 1분기 254억 원(영업이익 22억 원), 2분기 321억 원(영업이익 29억 원)이었다.","url":"https://etfshopping.com/stock/025880/earnings","date":"2026-10-05","chk":"맞음"}],"unknown":"회사 이름이 나온 2025~2026년 신문 기사를 찾지 못했다(검색 6번을 모두 씀). 그래서 농가가 이 회사 사료를 고르는 까닭, 돼지 · 닭 · 소 사료별 매출, 팔리는 지역, 국내 사료 시장 안 몫(%)은 확인하지 못했다. 자회사 케이씨팜이 하는 일은 인공지능이 쓴 구직 누리집 소개(알 낳는 닭 농장 · 달걀)에만 있어 믿기 어렵다. 모닝스타 소개에 적힌 식당 · 주유소 일을 지금도 하는지, 식품 · 비료 매출이 얼마인지도 모른다. 국내 순위 기사(농협 1위)는 2017년 것이라 지금 순위와 다를 수 있다. 국내 맞수 가운데 같은 크기의 상장 사료 회사(현대사료 · 고려산업 · 대주산업 등)는 기사에서 확인하지 못해 넣지 않았다.","webFacts":6,"file":"reports/atlas11/t365/grow/stories-20261014T0826Z.json","made":"2026-10-14"}}}
