165,3130,4065,4200,3950,3550,3865,4070,4265,4335,4115,3830,4105,3955,4000,3895,3770,3615,3390,3475,3210,3275,3340,3980,4000,3960,4040,4380,4155,4025,4075,4080,3935,3970,4200,4240,3955,4535,4680,4485,4385,4425,4245,4270,4170,4075,4090,4180,4170,4415,4185,4025],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[220,213,193],"op":[63,33,21],"net":[52,-121,20],"roe":[16.53,-29.6,4.54],"debt":[6.13,6.42,6.67]},"per":36.59,"pbr":3.3,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[220,213,193,null],"baseYear":"2025","baseRev":193,"ind":{"name":"기계 부품","n":18,"rank":16,"share":0.8,"near":2,"gap12":1.85,"size":"rev","me":193},"top":[["와이지-원",6394,"019210"],["대창단조",3463,"015230"],["태광",2970,"023160"],["성광벤드",2457,"014620"],["하이록코리아",2146,"013030"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":0.79,"mid":1.05,"hi":1.4,"t":"삼성전자 쪽 주문은 늘었지만 2년 내리 줄던 매출이라 제자리 근처일까요?","g":"반반"},"3":{"lo":0.74,"mid":1.15,"hi":1.75,"t":"반도체 · 로봇 공장이 늘면 케이블체인 쓰임도 커지는 쪽에 가깝습니다.","g":"높다"},"5":{"lo":0.7,"mid":1.22,"hi":2.05,"t":"나라 밖에서 이구스 같은 큰 회사와 맞서야 해 빨리 넓히긴 어렵지 않을까요?","g":"높다"},"10":{"lo":0.65,"mid":1.38,"hi":2.75,"t":"작은 회사여서 손님 몇 곳에 크기가 크게 바뀌어 갈래가 넓은 쪽에 가깝습니다.","g":"높다"}},"brk":"반도체 장비 투자가 길게 줄어드는 일.","teams":{"google":"매출이 220억 → 213억 → 193억 원으로 줄었습니다. 본업 이익도 63억 → 21억 원으로 줄었습니다.","apple":"움직이는 기계의 전선을 감싸는 케이블체인을 만듭니다. 손님이 1,000여 곳으로 흩어져 가장 큰 손님도 매출의 10%를 넘지 않습니다.","claude":"국내 케이블체인 시장은 세계의 4%대로 작습니다. 밖에서 큰 회사와 맞서야만 크는 구조가 아닐까요?"},"rivals":[{"name":"igus(이구스)","where":"유럽","note":"케이블체인 세계 큰 회사(독일)","url":""},{"name":"Tsubaki Kabelschlepp(쓰바키 카벨슐레프)","where":"일본","note":"케이블체인을 만드는 일본 쓰바키 그룹 회사","url":""}],"sells":"로봇·공작기계·반도체 장비처럼 움직이는 기계의 전선과 호스를 감싸 함께 움직이게 하는 케이블체인을 만듭니다. 현대차·삼성디스플레이·삼성중공업 같은 공장과, 테크윙·세메스·고영 같은 반도체 장비 회사(삼성전자 납품)가 삽니다.","why":"먼지가 아주 적은 클린룸용 체인(G-클린체인)이 강점이고, 손님이 1,000여 곳으로 흩어져 가장 큰 손님도 매출의 10%를 넘지 않습니다. 약점은 회사가 작다는 점입니다(2025년 매출 193억 원).","market":"반도체·로봇·자동화 공장이 늘면 커지는 판입니다. 다만 국내 케이블체인 시장은 세계의 4%대로 작아 나라 밖으로 넓혀야 합니다.","events":"2025년 상반기 삼성전자 쪽 케이블체인 매출이 이미 2024년 한 해의 75%에 이르렀다는 기사(2025년 9월)가 있습니다. 2024년에는 테슬라 독일 공장에 시험용 3세트를 보냈습니다.","facts":[{"text":"대표 인터뷰에 따르면 2023년 직거래 331곳·최종 손님 1,000여 곳이고, 가장 큰 손님도 매출의 10%를 넘지 않으며, 수출 비중은 약 27.3%입니다.","url":"https://v.daum.net/v/20240627151129825","date":"2024-06-27"},{"text":"삼성전자에 가는 케이블체인 매출이 2025년 상반기에 이미 2024년 전체의 75%에 이르렀고, 애플 협력사 폭스콘에 초저분진 체인을 공급한다고 적었습니다.","url":"https://view.asiae.co.kr/article/2025092314121448202","date":"2025-09-23"}],"unknown":"씨피시스템의 경쟁 회사를 이름으로 적은 기사, 국내외 시장 몫(%), 제2공장 내용(관련 기사 제목만 보고 본문은 못 봄)은 못 찾았습니다. 이구스·쓰바키는 업계에 널리 알려진 이름이라 넣었습니다.","webFacts":2,"file":"reports/atlas11/t365/grow/stories-20261011T1210Z.json","made":"2026-10-11"}}}
