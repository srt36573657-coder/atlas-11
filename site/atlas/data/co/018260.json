ev":[132768,138282,139299],"op":[8082,9111,9571],"net":[7013,7895,7827],"roe":[8.21,8.42,7.89],"debt":[37.27,36.4,31.09]},"per":23.38,"pbr":1.47,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[132768,138282,139299,144272],"baseYear":"2025","baseRev":139299,"ind":{"name":"IT 시스템 통합","n":10,"rank":1,"share":43.6,"near":1,"gap12":1.57},"top":[["삼성에스디에스",139299,"018260"],["아이티센글로벌",88708,"124500"],["LG씨엔에스",61295,"064400"],["롯데이노베이트",11698,"286940"],["신세계 I&C",6872,"035510"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":0.96,"mid":1.06,"hi":1.14,"t":"물류는 짐 나르는 값 따라 오르내려 위아래를 넓게 보는 쪽에 가깝습니다.","g":"높다"},"3":{"lo":0.94,"mid":1.11,"hi":1.3,"t":"삼성 계열사 일감이 바탕이라 갑자기 줄기도 늘기도 어려운 쪽에 가깝습니다.","g":"높다"},"5":{"lo":0.92,"mid":1.18,"hi":1.45,"t":"AI 일감은 LG CNS · SK AX와 바로 맞붙지 않을까요?","g":"높다"},"10":{"lo":0.88,"mid":1.4,"hi":1.95,"t":"이미 큰 회사여서 해마다 3%쯤 크는 쪽에 가깝습니다.","g":"높다"}},"brk":"삼성 계열사들이 IT 일감을 다른 회사에 크게 나눠 주면 범위 아래로 내려갑니다.","teams":{"google":"매출은 2025년 13조9299억으로 0.7% 늘었습니다. 2026년 증권사 평균치는 14조4272억(1.04배)입니다.","apple":"클라우드 · AI 업무 도구 · 시스템 구축과 물류 대행을 삼성 계열사와 대기업 · 공공에 팝니다. AI 전환 일감을 두고 LG CNS · SK AX와 맞붙습니다.","claude":"2026년 영업이익 평균치(8208억)는 2025년(9571억)보다 낮습니다. 물류 대행은 운임에 따라 오르내려 좋은 해를 기준으로 삼지 않는 쪽에 가깝습니다."},"rivals":[{"name":"LG CNS","where":"국내","note":"기업·공공의 AI 전환(AX) 일감을 두고 맞붙습니다.","url":"https://v.daum.net/v/20260530080153883"},{"name":"SK AX","where":"국내","note":"대기업·금융의 IT 시스템과 AI 일감을 두고 다툽니다.","url":"https://nextplatform.net/best-ai-company-samsung-sds-lg-cns-hyundai-autoever-sk-ax/"}],"sells":"IT 서비스(클라우드, AI 업무 도구, 시스템 구축·운영)와 물류 대행을 팝니다. 삼성 계열사와 국내 대기업·금융·공공 기관이 삽니다.","why":"삼성 계열사의 큰 시스템을 오래 맡아 온 경험이 고르는 까닭입니다. 약점은 AI 전환 일감에서 LG CNS와 바로 맞붙는다는 점입니다.","market":"공공·기업의 AI 전환 일감은 늘어나는 쪽입니다. 물류 대행 매출은 운임과 경기에 따라 오르내립니다.","events":"2026년 2월 미국·유럽 물류를 AI로 끌어올린다고 알렸습니다. 2026년 5월에는 'AX 서밋'을 열어 AI 업무 도구를 앞세웠습니다.","facts":[{"text":"2025년 영업이익은 9571억 원으로 1년 전보다 5% 늘었습니다.","url":"https://www.ajunews.com/view/20260122105108303","date":"2026-01-22"},{"text":"2026년 2분기 매출은 3.7조 원으로 1년 전보다 5.9% 늘었습니다. IT 서비스와 물류가 함께 컸습니다.","url":"https://news.mtn.co.kr/news-detail/2026073016232699172","date":"2026-07-30"},{"text":"2026년 5월 29일 'AX 서밋'에서 AI 에이전트 플랫폼 '패브릭스'와 업무 자동화 '브리티 오토메이션'을 내세웠습니다. 약 320개 회사에서 600명쯤 왔습니다.","url":"https://v.daum.net/v/20260530080153883","date":"2026-05-30"},{"text":"미국·유럽 물류 서비스를 AI로 끌어올린다는 소식이 나왔습니다.","url":"https://www.hankyung.com/article/2026021197971","date":"2026-02-11"}],"unknown":"삼성 계열사 매출 몫(숫자)과 물류 쪽 경쟁 회사는 확인하지 못했습니다. 클라우드 관리(MSP) 몫 23.9% 1위라는 데일리안 기사(https://www.dailian.co.kr/news/view/1447256/)는 날짜·기준을 못 봤고, 국가AI컴퓨팅센터·오픈AI 협력 진행도 글로 확인하지 못했습니다(이번 턴 웹 검색 한도가 다 참).","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
