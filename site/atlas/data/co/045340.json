,6360,6220,6010,6070,6410,6420,6460,6570,6590,6590,6870,6940,6870,6700,6650,6400,6560,6580,6550,6700,6860,6870,6850,6900,6920,6830,6700,6880,6900,6800,6900,6850,6850,6860,6820,6820,6740,6810,6760,6640,6800,6850,6780,6860,6780,6790,6820,6800,6830,6750,6800,6880],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[161,207,275],"op":[36,52,94],"net":[38,61,85],"roe":[18.58,24.76,26.65],"debt":[60.05,55.82,50.4]},"per":5.81,"pbr":1.42,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[161,207,275,null],"baseYear":"2025","baseRev":275,"ind":{"name":"물류·운송","n":25,"rank":25,"share":0.0,"near":2,"gap12":2.41,"size":"rev","me":275},"top":[["현대글로비스",295664,"086280"],["CJ대한통운",122847,"000120"],["한진",30649,"002320"],["롯데렌탈",29188,"089860"],["세방",12418,"004360"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":0.72,"mid":1.02,"hi":1.4,"t":"케냐 큰 계약 일이 끝나 가면 2027년은 2025년 크기쯤 아닐까요?","g":"반반"},"3":{"lo":0.66,"mid":1.1,"hi":1.7,"t":"큰 계약 몇 건에 매출이 흔들려 해마다 오르내림이 크지 않을까요?","g":"반반"},"5":{"lo":0.62,"mid":1.18,"hi":2.0,"t":"항구를 자동으로 바꾸는 일이 늘어 조금씩 클까요?","g":"반반"},"10":{"lo":0.52,"mid":1.4,"hi":2.8,"t":"몸집이 작아 나비스 같은 큰 맞수와 다퉈 천천히 크는 쪽에 가깝습니다.","g":"반반"}},"brk":"케냐 같은 큰 계약을 몇 해 동안 새로 따지 못하면 매출이 범위 아래로 내려갑니다.","teams":{"google":"매출은 2023년 161억 → 2024년 207억 → 2025년 275억 원으로 빨리 늘었지만, 같은 업종 25곳 가운데 25번째 크기입니다.","apple":"항구 터미널 쪽이 2026년 2분기 매출의 91%이고, 케냐 항만청 · 스페인 노아툼 포트가 손님입니다.","claude":"국내 첫 완전 자동화 터미널 일은 사이버로지텍이 맡아, 큰 자동화 항구 다툼에서 밀리면 우리 범위도 높은 쪽일 수 있습니다."},"rivals":[{"name":"나비스(Navis)","where":"미국","note":"항만 물류 프로그램 세계 1위로 소개되는 회사로, 터미널 운영 프로그램 N4로 다툰다.","url":"https://eureka.hankyung.com/insight/detail/12094"},{"name":"타이드웍스(Tideworks)","where":"미국","note":"북미 중심으로 큰 컨테이너 터미널용 운영 프로그램 메인세일(Mainsail)을 판다.","url":"https://theintechgroup.com/blog/tos-buyers-guide-terminal-operating-system/"},{"name":"사이버로지텍(CyberLogitec)","where":"국내","note":"OPUS 터미널 프로그램으로 다투는 국내 회사다.","url":"https://eureka.hankyung.com/insight/detail/12094"}],"sells":"항구에서 짐 상자(컨테이너)를 싣고 내리는 터미널의 일을 짜고 관리하는 프로그램 CATOS가 주력이다. 2026년 2분기 매출의 91%가 터미널 쪽, 8%가 해운(배) 쪽, 1%가 온라인 교육이다. 손님은 나라 밖 항만 회사가 많아 매출의 90% 이상이 해외에서 나온다는 글이 있고, 케냐 항만청과 스페인 항만 회사 노아툼 포트가 손님으로 나온다.","why":"1988년부터 항만 프로그램을 만들어 세계 약 70곳 컨테이너 터미널의 일을 도왔고, 스페인·그리스·이집트·대만·베트남 등에 지사를 두고 현지에 맞춰 준다. 2018년 머스크 계약에서 항만 물류 프로그램 세계 1위로 소개되는 나비스를 제쳤다는 글도 있다. 약점은 회사가 작아 큰 계약 몇 건에 매출이 크게 흔들린다는 점(케냐 계약 하나가 매출의 60.2%)이고, 경쟁 업체가 쓴 2026년 비교 글은 CATOS를 '중간 크기 다목적 터미널용, 회사 안 서버에만 설치'로 매겼다.","market":"세계 컨테이너 터미널 운영 프로그램 시장은 2024년 12억 달러 규모로, 2033년 25억 달러까지 커진다고 본 시장 조사 회사 자료가 있다. 항구를 자동화·디지털화하는 사업이 이어지고 있고(스페인 노아툼 포트의 PORTOS 사업 등), 2026년 8월 국내 첫 완전 자동화 컨테이너 터미널(인천신항 1-2단계)의 운영 프로그램은 경쟁사 사이버로지텍이 맡았다.","events":"2025년 3월 케냐 항만청과 96.8억 원(매출의 60.2%), 4월 스페인 발렌시아 터미널과 27.6억 원 계약을 맺었다는 글이 있다. 2025년 매출은 275억 원으로 한 해 전보다 32.8% 늘었고 영업이익은 81% 늘었다. 2026년 2월에도 새 공급 계약 공시(회사가 거래소에 공식으로 알리는 글)를 냈다(상대와 금액은 확인 못 함).","facts":[{"text":"2026년 2분기 매출을 기준으로 사업 몫은 항만 터미널 91%, 해운(배) 8%, 온라인 교육 1%다.","url":"https://www.butler.works/ko/companies/00355089","date":"","chk":"맞음"},{"text":"배 자동화 프로그램과 항만·항만 공동체 프로그램을 만드는 회사로, 세계 약 70곳 컨테이너 터미널의 일 처리를 높이는 데 이바지했다고 소개된다.","url":"https://morningstar.com.au/investments/security/XKRX/045340","date":"","chk":"맞음"},{"text":"스페인 항만 회사 노아툼 포트는 카르타헤나·카스테욘·사군토·말라가 터미널에서 토탈소프트뱅크가 만든 CATOS를 쓰고, 이를 터미널 디지털화 사업(PORTOS)과 함께 돌린다.","url":"https://www.drybulkmagazine.com/special-reports/02072025/transforming-terminal-operations-noatum-ports-presents-the-portos-project/","date":"","chk":"맞음"},{"text":"매출의 90% 이상이 해외에서 나오고, 2025년 3월 케냐 항만청과 96.8억 원(매출의 60.2%), 4월 스페인 발렌시아 터미널과 27.6억 원 계약을 맺었다고 적혀 있다. 경쟁 회사로 싸이버로지텍·나비스·타이드웍스를 꼽았다.","url":"https://eureka.hankyung.com/insight/detail/12094","date":"2025-04-29","chk":"맞음"},{"text":"2026년 터미널 운영 프로그램 비교 글은 나비스 N4, 타이드웍스 메인세일과 함께 CATOS를 올렸다. CATOS는 '회사 안 서버에만 설치, 중간 크기 다목적 터미널에 맞음'으로 분류됐다(글쓴이는 경쟁 업체 인텍).","url":"https://theintechgroup.com/blog/tos-buyers-guide-terminal-operating-system/","date":"2026-05-25","chk":"맞음"},{"text":"사이버로지텍이 인천글로벌컨테이너터미널(IGCT)과 인천신항 1-2단계 자동화 컨테이너 터미널(인천항 첫 완전 자동화 터미널)에 터미널 운영 프로그램을 대기로 계약했고, 2028년 상업 운영 시작이 목표다.","url":"https://kyodonewsprwire.jp/release/202608113981","date":"2026-08-11","chk":"맞음"}],"unknown":"공시 원문(케냐 계약 조건, 2026년 2월·10월 공급 계약의 상대와 금액)을 열어 보지 못했다. CATOS를 쓰는 터미널 수의 최근 숫자와 세계 시장 몫(%)도 못 찾았다. '매출 90% 이상 해외'·'CATOS가 매출의 77%' 같은 숫자는 한경 유레카의 자동 분석 글에서 나온 것이라 공시와 맞대 보지 못했다. 노아툼 포트 글은 날짜가 화면에 없다(주소에는 2025년 7월 2일로 보이는 숫자가 있다). 이번 작업 중 검색 횟수가 바닥나 2025~2026년 한국 신문 기사를 더 찾지 못했다.","webFacts":6,"file":"reports/atlas11/t365/grow/stories-20261014T0826Z.json","made":"2026-10-14"}}}
