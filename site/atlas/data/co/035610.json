800,4720,4670,4620,4520,4550,4695,4715,4800,4920,4930,4815,4860,4875,4835,4880,5040,4610,4535,4610,4700,4910,4990,5050,5000,5030,5040,4980,4950,4955,5060,4795,4795,4995,4990,5040,5090,5030,5220,5290,5260,5210,5180,5060,5060,5020,4980,4950,4895,4930,4880,4965],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[1172,1161,1207],"op":[299,212,246],"net":[462,545,345],"roe":[25.77,19.02,10.28],"debt":[19.54,19.49,20.08]},"per":3.89,"pbr":0.56,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[1172,1161,1207,null],"baseYear":"2025","baseRev":1207,"ind":{"name":"헬스케어 기술","n":11,"rank":2,"share":17.5,"near":4,"gap12":1.64,"size":"rev","me":1207},"top":[["GC메디아이",1977,"032620"],["솔본",1207,"035610"],["인피니트헬스케어",1024,"071200"],["루닛",831,"328130"],["이지케어텍",789,"099750"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.92,"mid":1.09,"hi":1.25,"t":"매출 대부분이 자회사 영상 프로그램이라 그만큼 크는 쪽에 가깝습니다.","g":"높다"},"3":{"lo":0.85,"mid":1.18,"hi":1.52,"t":"자회사 상장 심사가 길어지면 해외 병원이 망설이지 않을까요?","g":"높다"},"5":{"lo":0.75,"mid":1.26,"hi":1.78,"t":"솔본 매출은 자회사 흐름을 그대로 따라가는 쪽에 가깝습니다.","g":"높다"},"10":{"lo":null,"mid":null,"hi":null,"t":"? 자료 모자람 · 다른 매출과 자회사를 계속 거느릴지를 못 봤습니다.","g":null}},"brk":"솔본이 인피니트헬스케어를 남에게 넘겨 매출 대부분이 빠지는 일.","teams":{"google":"솔본 매출 1207억 원에 자회사 매출 1024억 원이 담긴 쪽에 가깝습니다.","apple":"병원이 고르는 것은 솔본이 아니라 자회사의 의료영상 프로그램입니다.","claude":"자회사 경영 다툼과 상장 심사가 솔본 매출도 흔들지 않을까요?"},"rivals":[{"name":"섹트라(Sectra)","where":"유럽","note":"자회사 인피니트헬스케어의 상대 · 병원 전체 영상 관리 프로그램으로 다툼"},{"name":"후지필름(Fujifilm)","where":"일본","note":"자회사의 상대 · 의료영상 프로그램 'Synapse'로 다툼","chk":{"v":"확인 못 함","url":"https://www.dt.co.kr/article/10535908"}},{"name":"GE헬스케어(GE HealthCare)","where":"미국","note":"자회사의 상대 · 영상 장비와 프로그램을 함께 팔며 다툼"}],"sells":"솔본은 직접 물건을 거의 팔지 않는 지주회사다. 병원 의료영상 저장 프로그램(PACS)을 파는 인피니트헬스케어의 몫(지분) 48.66%를 가진 최대주주이고, 그 회사가 돈줄의 중심이다.","why":"솔본을 직접 고르는 손님은 없고, 병원이 고르는 것은 자회사 인피니트헬스케어의 영상 프로그램이다. 약점은 경영자문료 논란과 자회사 거래정지로 회사 운영 문제가 드러났다는 점이다.","market":"자회사의 의료영상 프로그램 시장을 따라간다. 국내는 이미 많이 깔려 있고, 늘어나는 쪽은 해외다(인피니트헬스케어 수출 몫 2024년 60.7%).","events":"2025년 12월 경영자문료 논란 보도 뒤, 인피니트헬스케어가 솔본과의 2025년 자문 계약을 풀고 이미 낸 자문료를 모두 돌려받기로 했다. 앞으로 이런 계약을 맺지 않겠다고 해, 솔본 자체 수입은 줄어드는 쪽입니다.","facts":[{"text":"솔본은 인피니트헬스케어 몫(지분)을 48.45%에서 48.66%로 늘렸다(2025년 8월 18일).","url":"https://www.digitaltoday.co.kr/aigongsi/1994/solborn-infinitehealthcare-stake-increase","date":"2025-08-25"},{"text":"솔본의 주된 수입은 인피니트헬스케어에서 받는 경영자문 수수료였고, 10년 동안 205억 원을 받았다. 솔본 직원은 4명(임원 포함 11명)이다.","url":"https://www.hankyung.com/article/202511266436r","date":"2025-12-02"},{"text":"인피니트헬스케어 이사회가 솔본과의 2025년 경영자문 계약을 풀고, 이미 낸 자문료를 모두 돌려받기로 했다.","url":"https://core.asiae.co.kr/article/2025121714192936867","date":"2025-12-17"}],"unknown":"다른 투자회사들이 솔본 매출에서 차지하는 몫과, 자문 계약이 풀린 뒤 솔본 자체 수입이 얼마나 줄었는지는 못 찾았다. 경쟁 회사는 자회사 인피니트헬스케어의 상대로, 업계에 널리 알려진 회사로 적었다.","webFacts":3,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
