0,8440,8360,10340,9720,8940,9190,9000,8730,7370,7460,6350,5850,5640,6990,6920,7660,7730,7420,7000,7370,7860,8020,8160,7930,7630,7370,7320,6860,6780,6890,6970,6910,6770,6830,6640,7580,8490,8460,9170,8770,8900,8700,8850,9060,9040,9090,9250,10020,9820,9760,9930,10590,11140,11070,11780,12070,12040,11640,11750],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[13027,11995,12524],"op":[489,334,204],"net":[390,232,6],"roe":[13.25,1.88,-4.1],"debt":[100.99,71.75,102.16]},"per":null,"pbr":1.47,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[13027,11995,12524,null],"baseYear":"2025","baseRev":12524,"ind":{"name":"전자부품","n":18,"rank":7,"share":2.8,"near":6,"gap12":1.94,"size":"rev","me":12524},"top":[["LG이노텍",218966,"011070"],["삼성전기",113145,"009150"],["비에이치",17927,"090460"],["솔루엠",17002,"248070"],["코리아써키트",15097,"007810"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.88,"mid":1.05,"hi":1.24,"t":"반도체 검사 회사 인수가 끝나면 매출이 조금 붙는 쪽에 가깝습니다.","g":"반반"},"3":{"lo":0.82,"mid":1.08,"hi":1.4,"t":"TV 전원 회로판은 중국 회사와 값 싸움이 세 크게 늘기 어려울까요?","g":"반반"},"5":{"lo":0.76,"mid":1.11,"hi":1.55,"t":"자동차 · 선박 부품으로 옮겨 가지만 아직 작은 쪽에 가깝습니다.","g":"반반"},"10":{"lo":0.65,"mid":1.18,"hi":2.0,"t":"지난 3년 매출이 1조2천억 원 안팎에 머문 흐름이 이어질까요?","g":"반반"}},"brk":"TV 전원 회로판 큰 손님을 잃으면 이 그림이 크게 틀어집니다.","teams":{"google":"장사로 남긴 돈(영업이익)이 2023년 489억 원에서 2025년 204억 원으로 줄었습니다.","apple":"TV 전원 회로판을 베트남 호치민에 모아 싸게 많이 만드는 것이 힘입니다.","claude":"2025년 순이익이 6억 원뿐인데 1,772억 원을 들여 회사를 사면 빚 짐이 커질까요?"},"rivals":[{"name":"솔루엠","where":"국내","note":"TV · 가전용 전원 장치(파워보드 · 3in1 보드)로 다툰다.","url":"https://view.asiae.co.kr/article/2023050915242521781"},{"name":"비에이치(자회사 비에이치이브이에스)","where":"국내","note":"차량용 무선충전 모듈로 다툰다.","url":"https://view.asiae.co.kr/article/2026042112043028166"}],"sells":"TV용 · 가전용 전원 회로판(파워보드)을 베트남 · 태국에서 만들고, 자동차 전장 부품(전자변속장치 · LED · 무선충전모듈), 반도체 쪽 사업, 선박 엔진 제어기로 넓히고 있다. 선박 쪽은 HD현대중공업 · 한화엔진이 사고, TV · 가전 쪽 손님 이름은 기사에서 확인 못 했다.","why":"TV 파워보드를 베트남 호치민 한 곳에 모아 싸게 많이 만들 수 있다. 약점은 중국 회사와의 값 싸움과 품질 수리(A/S) 비용으로 이익이 얇아졌다는 점이다(영업이익률 2023년 3.8% → 2025년 1.6%).","market":"TV 파워보드는 크게 늘지 않고 값 싸움이 센 판이다. 그래서 회사는 자동차 전장(북미) · 반도체 · 선박 부품처럼 커지는 쪽으로 옮겨 가고 있다.","events":"2026년 2월 태양광 모듈 사업(매출의 약 4%)을 자회사로 떼어 냈고, 4월 반도체 검사 분야 회사 윌테크놀러지 지분 83.4%를 1,772억 원에 사기로 했다. 7월에는 북미 자동차 부품을 만들 멕시코 법인을 세웠다.","facts":[{"text":"2025년 매출은 1조2,524억 원(4.4% 증가), 영업이익은 204억 원(38.8% 감소)이었다. TV 파워보드 생산은 베트남 호치민 법인으로 합치고, 태국 공장은 가전용 파워보드 전문으로 바꾼다.","url":"https://dealsite.co.kr/articles/156509","date":"2026-02-06"},{"text":"영업이익률은 2023년 3.8%, 2024년 2.8%, 2025년 1.6%로 낮아졌다. 파워보드는 중국 업체와의 가격 경쟁으로 수익성이 낮아지는 부담이 있다고 기사는 적었다.","url":"https://newstomato.com/ReadNews.aspx?no=1294202","date":"2026-03-13","chk":"맞음"},{"text":"반도체 검사 분야 회사 윌테크놀러지 지분 83.4%를 1,772억 원에 사기로 했다(공정위 승인 조건). 윌테크놀러지의 2025년 매출은 674억 원, 영업이익은 96억 원이다.","url":"https://dealsite.co.kr/articles/160055","date":"2026-04-13"},{"text":"멕시코 법인을 새로 세워 전자변속장치 · 내외장 LED · 무선충전모듈 같은 자동차 전장 부품으로 북미 손님에게 대응한다.","url":"https://news.mtn.co.kr/news-detail/2026071311071935180/share-modal","date":"2026-07-13"}],"unknown":"TV · 가전 파워보드의 손님 이름과 매출 비중, 값 싸움 상대인 중국 회사 이름, 윌테크놀러지 인수가 끝났는지는 확인 못 했다. 입력 자료의 제품 이름(백라이트유닛 · 인버터 등)이 지금도 매출에 있는지, 반도체 · 선박 부품 쪽 경쟁 회사도 못 찾았다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1210Z.json","made":"2026-10-11"}}}
