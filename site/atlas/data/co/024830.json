290,10110,10180,10200,10150,9990,10240,10160,10150,10300,10370,10370,10480,10500,10480,10160,10090,10060,9750,9270,9530,9250,9280,9250,8920,9320,8960,8770,8700,8880,8700,8700,8670,8770,8760,8770,8710,8670,8560,8630,8520,8520,8530,8550,8970,8920,8770,8760,8790,8830,8910,8900,8880,8940,8710,8620,8960,9000,9060,9010,8980,8480,8670,8570,8520,8580,8670,8480,8430,8490,8420,8560,8460,8510,8540,8510,8400,8420,8400,8390,8310,8420,8420,8320,8330,8220,8190,8040,8170,8140,8090],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[1930,2309,2116],"op":[59,13,31],"net":[127,220,186],"roe":[4.24,5.95,4.79],"debt":[29.64,24.65,22.39]},"per":4.94,"pbr":0.17,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[1930,2309,2116,null],"baseYear":"2025","baseRev":2116,"ind":{"name":"자동차부품","n":146,"rank":89,"share":0.1,"near":47,"gap12":2.88,"size":"rev","me":2116},"top":[["현대모비스",611181,"012330"],["한국타이어앤테크놀로지",212023,"161390"],["한온시스템",108837,"018880"],["HL만도",94548,"204320"],["현대위아",84816,"011210"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.76,"mid":0.93,"hi":1.1,"t":"2026년 2분기 매출이 30.3% 줄어 2027년도 작지 않을까요?","g":"낮다"},"3":{"lo":0.72,"mid":0.98,"hi":1.26,"t":"차종이 바뀔 때 새 일감을 다시 받느냐에 따라 크게 달라지지 않을까요?","g":"반반"},"5":{"lo":0.68,"mid":1.0,"hi":1.38,"t":"새 공장 투자 소식이 없어 크게 늘 길은 좁은 쪽에 가깝습니다.","g":"반반"},"10":{"lo":0.55,"mid":1.05,"hi":1.65,"t":"가벼운 차체와 미국 공장을 갖춘 맞수와 다퉈 제자리 쪽이 아닐까요?","g":"반반"}},"brk":"현대차가 차종을 바꿀 때 차체 부품을 다른 회사에 맡기면 이 이야기는 아래로 크게 틀립니다.","teams":{"google":"매출은 2023년 1,930억 → 2024년 2,309억 → 2025년 2,116억 원이고, 2025년 영업이익은 31억 원뿐입니다.","apple":"뒤쪽 바닥판 같은 철판 차체 부품을 현대차에 대고, 아반떼 · 투싼 · 팰리세이드 · GV80 등에 들어갑니다.","claude":"순이익 186억 원이 영업이익 31억 원보다 훨씬 커서, 주당 이익이 빨리 늘었어도 본업 매출의 힘은 약한 쪽에 가깝습니다."},"rivals":[{"name":"성우하이텍","where":"국내","note":"범퍼 · 차체 뼈대 부품으로 현대차 물량을 다투고, 미국 새 공장 대응력이 기사에 따로 적혔다.","url":"https://hankyung.com/article/202610020826i"},{"name":"화신","where":"국내","note":"현대차에 차체 부품을 대는 같은 무리의 회사로, 미국 새 공장 대응력이 기사에 따로 적혔다.","url":"https://hankyung.com/article/202610020826i"},{"name":"엠에스오토텍","where":"국내","note":"핫스탬핑(철판을 뜨겁게 찍어 단단하게 만드는 방식) 차체 부품으로 다툰다.","url":"https://hankyung.com/article/202610020826i"}],"sells":"자동차의 뼈대가 되는 철판 부품(차체 부품)을 프레스(큰 누르는 기계)로 찍어 만든다. 뒤쪽 바닥판 · 펜더 에이프런(앞바퀴 둘레 안쪽 뼈대) · 라디에이터 서포트 같은 부품이다. 사는 곳은 현대자동차와 현대차 계열 회사이고, 아반떼 · 투싼 · 싼타페 · 팰리세이드 · GV70 · GV80 등에 들어간다.","why":"현대자동차가 정한 LEVEL-1 공장으로 인정받았고(불량률 100PPM, 곧 100만 개 중 100개 꼴), 아반떼부터 팰리세이드까지 여러 차종에 오래 부품을 대 왔다. 약점은 손님이 현대차그룹에 몰려 있고 남는 돈이 아주 적다는 점이다(2025년 매출 2,116억 원에 영업이익 31억 원). 2026년 1분기와 2분기에는 영업손실을 냈다.","market":"차체 부품은 차종마다 맞춘 생산 설비와 큰 초기 개발비가 들어 새 회사가 들어오기 어렵지만, 완성차 회사가 차를 얼마나 만드느냐에 따라 일감이 바로 바뀐다. 2026년 10월 기사는 철판을 찍는 전통 차체 부품 회사들이 완성차 회사의 생산 물량 조절 여파를 바로 받는다고 적었고, 가벼운 차체 부품이나 미국 새 공장(HMGMA) 대응력을 갖춘 회사를 따로 짚었다.","events":"2026년 3월 31일 대표이사 변경을 공시했다. 2026년 2분기 매출은 416억 원으로 1년 전보다 30.3% 줄었고 영업손실 17억 원을 냈다. 2025~2026년 공시 목록에서 새 공장 투자나 큰 공급 계약 공시는 찾지 못했다.","facts":[{"text":"세원물산은 1985년에 세운 자동차 차체 부품 회사다. 뒤쪽 바닥판 · 펜더 에이프런 같은 부품을 현대자동차와 현대차 계열 회사에 대고, 아반떼 · GV80 · GV70 · 싼타페 · 투싼 · 팰리세이드 등에 넣으며 오래 거래를 이어 오고 있다.","url":"https://valueline.co.kr/finance/summary/024830","date":"","chk":"맞음"},{"text":"1,500톤급 큰 프레스 라인과 철판 두께를 바꿔 붙이는 레이저 용접 장비를 갖췄고, 불량률 100PPM을 이뤄 현대자동차가 정한 LEVEL-1 공장으로 인정받았다. 차체 부품 시장은 차종마다 맞춘 생산 체제와 큰 초기 개발비 때문에 새로 들어오기 어렵다고 적혀 있다.","url":"https://valueline.co.kr/finance/summary/024830","date":"","chk":"맞음"},{"text":"세원그룹은 현대차의 1차 협력업체로 코스피의 세원정공과 코스닥의 세원물산을 거느린다. 오너 일가가 두 아들의 비상장 회사에 일감을 몰아준 혐의로 기소됐고, 2022년 3월 오너 일가가 계열사 직책에서 모두 물러났다.","url":"https://v.daum.net/v/20231128100202902","date":"2023-11-28","chk":"맞음"},{"text":"한국경제는 현대차 주요 협력사 68곳을 나눠 보며 세원물산을 성우하이텍 · 화신 · 엠에스오토텍 · 아진산업 · 일지테크 등과 같은 차체 부품 무리에 넣었다. 기사는 전통 프레스 · 철강 차체 부품 회사들이 완성차 회사의 생산 물량 조절 여파를 바로 받는다고 적었다.","url":"https://hankyung.com/article/202610020826i","date":"2026-10-03","chk":"맞음"},{"text":"2026년 1분기 매출은 543억 원(1년 전보다 19.5% 늘어남)이었지만 영업손실 20억 원을 냈다. 2분기 매출은 416억 원으로 1년 전보다 30.3% 줄었고 영업손실은 17억 원이었다.","url":"https://etfshopping.com/stock/024830/earnings","date":"2026-10-12","chk":"맞음"},{"text":"2026년 3월 31일 대표이사 변경을 공시했다. 2025~2026년 공시 목록에는 단일 판매 · 공급 계약이나 새 시설 투자 공시가 없다.","url":"https://m.irgo.co.kr/IR-COMP/024830/%EC%84%B8%EC%9B%90%EB%AC%BC%EC%82%B0-IR-PAGE","date":"","chk":"맞음"}],"unknown":"회사별 시장 몫(%)과 차종별 매출 비중은 못 찾았다. 2026년 2분기 매출이 크게 준 까닭(어느 차종 물량이 줄었는지)은 확인하지 못했다. 2025~2026년에 이 회사만 다룬 뉴스 기사를 찾지 못했고, 조사 중 검색 한도가 다 차서 더 찾지 못했다. 2026년 4 · 5 · 7월 담보 제공 · 채무 보증 공시의 내용과 관계회사(세원테크 · 제이엠오토 · 중국 법인 두 곳)의 실적은 못 봤다. 미국 조지아 공장(Sewon America)은 계열사 세원정공의 자회사로 나와 세원물산 매출과의 관계는 확인하지 못했다. 본사 위치는 자료마다 대구 · 영천으로 달랐다. 나라 밖 경쟁 회사는 기사에서 찾지 못해 넣지 않았다.","webFacts":6,"file":"reports/atlas11/t365/grow/stories-20261014T0826Z.json","made":"2026-10-14"}}}
