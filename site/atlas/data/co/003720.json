00,5900,5690,5700,5710,6260,6050,6310,6060,5680,5300,6280,6380,6870,7300,7050,7000,7680,7420,7240,7300,7220,7000,6830,6860,6560,6510,6540,6520,6540,6490,6420,6260,6080,5950,6060,6180,6030,6180,6170,6190,6100,6210,6410,6630,6600,6480,6420,6460,6350,6320,6240,6450,6470,6640,6440,6330],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[1226,1260,1532],"op":[60,91,149],"net":[189,83,150],"roe":[31.45,11.52,16.59],"debt":[96.59,83.4,124.75]},"per":10.51,"pbr":2.18,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[1226,1260,1532,2084],"baseYear":"2025","baseRev":1532,"ind":{"name":"화학","n":22,"rank":20,"share":0.5,"near":4,"gap12":1.43},"top":[["코오롱인더",48734,"120110"],["에코프로",34130,"086520"],["OCI홀딩스",33801,"010060"],["삼양홀딩스",33483,"000070"],["HS효성첨단소재",32830,"298050"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":1.05,"mid":1.38,"hi":1.7,"t":"전기 저장 장치가 늘어 콘덴서 필름을 찾는 곳이 늘어나는 쪽에 가깝습니다.","g":"아주 높다"},"3":{"lo":0.98,"mid":1.52,"hi":2.3,"t":"빨리 크는 판이라 퉁펑전자 같은 중국 회사가 몰려 값 싸움이 커지지 않을까요?","g":"아주 높다"},"5":{"lo":0.88,"mid":1.65,"hi":2.85,"t":"전기 저장 장치 · 태양광은 나라 정책에 따라 오르내림이 큰 쪽에 가깝습니다.","g":"높다"},"10":{"lo":0.7,"mid":1.9,"hi":3.9,"t":"회사가 작고 빚이 늘어 10년 갈래가 아주 넓은 쪽에 가깝습니다.","g":"높다"}},"brk":"중국 회사들이 콘덴서 필름을 크게 늘려 값이 떨어지면 이 판단은 틀립니다.","teams":{"google":"2025년 매출은 22% 늘었고, 증권사는 2026년에 36% 더 늘어난다고 봅니다.","apple":"콘덴서에 들어가는 얇은 필름을 만듭니다. 이 필름은 전기 저장 장치 · 태양광에 쓰입니다.","claude":"빚 비율이 1년 새 83%에서 125%로 뛰었는데, 까닭은 아직 모릅니다."},"rivals":[{"name":"도레이","where":"일본","note":"큰 필름 회사 · 콘덴서용 얇은 필름으로 다툼","url":""},{"name":"오지에프텍스","where":"일본","note":"아주 얇은 콘덴서용 필름으로 다툼","url":""},{"name":"퉁펑전자(铜峰电子)","where":"중국","note":"콘덴서용 필름과 콘덴서를 만드는 중국 회사","url":""}],"sells":"콘덴서(전기를 잠깐 담아 두는 부품)에 들어가는 얇은 필름을 만드는 회사로 소개되고, 포장용 필름·랩·종이상자도 만듭니다. 이 필름은 전기 저장 장치(ESS)·발전설비·태양광·가전·전력 변환 장치에 쓰입니다.","why":"손님이 이 회사를 고르는 까닭(품질·값·납기)은 글에서 찾지 못했습니다(?). 다만 커패시터 필름 수출이 2025년 1분기 760만 달러에서 2분기 890만 달러로 늘었다는 자료가 있어, 나라 밖에서 찾는 곳이 늘어나는 쪽입니다.","market":"AI 데이터센터·전기 저장 장치·태양광이 늘면서 커패시터 필름을 찾는 곳이 오래 늘어나는 흐름이라고 기사는 봅니다.","events":"찾지 못했습니다. 본 기사에는 계약·공장·주인 바뀜 소식이 없었습니다.","facts":[{"text":"커패시터 필름은 필름형 콘덴서의 핵심 재료이며, 전기 저장 장치(ESS)·발전설비·태양광·가전·전력 변환 장치(PCS)에 쓰입니다.","url":"https://core.asiae.co.kr/article/2025112515500120186","date":"2025-11-26"},{"text":"삼영의 2025년 3분기 매출은 458억 원, 영업이익은 56억 원으로, 1년 전보다 매출 47.2%, 영업이익 154.8% 늘었습니다.","url":"https://core.asiae.co.kr/article/2025112515500120186","date":"2025-11-26"},{"text":"기사에 따르면 커패시터 필름 수출은 2025년 1분기 760만 달러에서 2분기 890만 달러로 늘었습니다.","url":"https://core.asiae.co.kr/article/2025112515500120186","date":"2025-11-26"},{"text":"하나증권은 삼영의 2025년 매출을 1,630억 원, 영업이익을 156억 원으로 추정했습니다.","url":"https://core.asiae.co.kr/article/2025112515500120186","date":"2025-11-26"}],"unknown":"경쟁 회사 이름과 점유율은 글에 없어 업계에 널리 알려진 이름으로 채웠고, 판의 모양도 글 근거 없이 골랐습니다(?). 산 회사 이름, 수출 숫자가 삼영 것인지 나라 전체 것인지, 2025년 빚 비율이 124.75%로 뛴 까닭(설비를 늘렸는지), 2025~2026년 공장·계약·주인 바뀜 소식을 찾지 못했습니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
