899,1827,1866,1746,1622,1666,1815,1861,1962,2030,2005,1967,2065,2070,2050,2045,2060,2080,1988,2045,1989,1896,1990,2020,2045,2040,2000,1979,1935,1911,1990,1967,1967,1960,1989,1967,1952,1939,1954,1952,1960,2140,2085,2050,2140,2380,2300,2355,2370,2470,2350,2365],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[1553,1656,1877],"op":[87,59,58],"net":[5,61,62],"roe":[1.29,5.63,6.12],"debt":[46.75,59.84,48]},"per":4.71,"pbr":0.62,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[1553,1656,1877,null],"baseYear":"2025","baseRev":1877,"ind":{"name":"소프트웨어","n":21,"rank":5,"share":6.3,"near":5,"gap12":1.31,"size":"rev","me":1877},"top":[["한컴위드",7712,"054920"],["지어소프트",5871,"051160"],["한컴",3267,"030520"],["안랩",2677,"053800"],["MDS테크",1877,"086960"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":1.02,"mid":1.24,"hi":1.48,"t":"2026년 상반기 매출이 22.5% 늘어 2027년까지는 크는 쪽에 가깝습니다.","g":"아주 높다"},"3":{"lo":0.95,"mid":1.38,"hi":1.95,"t":"AI 서버는 사는 해와 쉬는 해가 갈려 매출이 오르내리지 않을까요?","g":"아주 높다"},"5":{"lo":0.88,"mid":1.52,"hi":2.4,"t":"남의 제품을 파는 몫이 커서 공급 회사 정책에 흔들리지 않을까요?","g":"높다"},"10":{"lo":0.72,"mid":1.8,"hi":3.5,"t":"로봇 · 공장용 작은 AI 컴퓨터가 늘면 천천히 크는 쪽에 가깝습니다.","g":"높다"}},"brk":"엔비디아가 젯슨을 파는 국내 회사를 늘리면 매출이 범위 아래로 내려갑니다.","teams":{"google":"매출이 2024년 1656억 원에서 2025년 1877억 원으로 13% 늘었습니다. 영업이익은 58억 원으로 매출의 3%입니다.","apple":"엔비디아 작은 AI 컴퓨터 '젯슨'을 국내에서 혼자 팔고 AI 서버도 공급합니다. 직접 다투는 회사 이름은 글에서 못 찾았습니다.","claude":"남는 돈이 매출의 3%뿐이라, 공급 회사가 조건을 바꾸면 버티기 어렵지 않을까요?"},"rivals":[],"sells":"기계 속 소프트웨어를 만드는 개발 도구(TRACE32 등)를 팔고, 엔비디아의 작은 AI 컴퓨터 '젯슨'을 국내에서 혼자 팔며, 엔비디아 AI 서버와 차량 전자장치 검증 솔루션도 공급합니다. 자동차·모바일·국방·항공 분야 거래처 약 1,500곳이 삽니다.","why":"엔비디아 젯슨 국내 단독 총판이자 AI 서버 공식 파트너라서 엔비디아 장비가 필요한 곳이 찾아옵니다. 약점은 남의 제품을 파는 몫이 커서 남는 돈이 적고(2025년 매출 1,877억 원에 영업이익 58억 원), 공급 회사의 정책에 흔들리기 쉽다는 점입니다.","market":"커지는 쪽입니다. 로봇·공장 같은 '피지컬 AI'와 데이터센터에서 엔비디아 장비 수요가 늘고 있고, 2026년 상반기 매출이 1년 전보다 22.5% 늘었습니다.","events":"2025년 엔비디아 블랙웰 AI 서버 공식 파트너로 소개됐습니다. 2026년 상반기 매출 1,085억 원(+22.5%)·영업이익 87억 원(+159%)이었고, 공장·소송·주인 바뀜 소식은 못 찾았습니다.","facts":[{"text":"2026년 상반기 매출은 1,085억 원으로 1년 전보다 22.5% 늘었고 영업이익은 87억 원으로 159% 늘었습니다. 기존 임베디드 거래처는 1,500곳 안팎입니다.","url":"https://news.mtn.co.kr/news-detail/2026100713045764353","date":"2026-10-07"},{"text":"엔비디아 엣지 AI용 소형 컴퓨터 모듈의 국내 단독 총판이며 A100·H100·블랙웰 AI 서버 공급 공식 파트너입니다. 2024년 엔비디아 관련 매출은 전체의 약 20%였습니다.","url":"https://view.asiae.co.kr/article/2025071408210645807","date":"2025-07-14"},{"text":"정부·삼성전자·현대차그룹·SK·네이버가 블랙웰 GPU 약 25만 장을 받는 계획이 보도됐지만, MDS테크가 이 물량에 직접 들어간다는 공식 확인은 기사에 없습니다.","url":"https://www.finance-scope.com/article/view/scp202510310019","date":"2025-10-31","chk":"맞음"},{"text":"2010년 기사에서 국내 임베디드 솔루션 시장 점유율 65%로 1위라고 소개됐습니다(오래된 자료).","url":"https://newstomato.com/ReadNews.aspx?no=92920","date":"2010-05-07"}],"unknown":"MDS테크와 직접 다투는 회사 이름을 글에서 하나도 못 찾아 rivals 를 비워 두었습니다(같은 종류 해외 도구 회사는 협력 관계일 수도 있어 넣지 않음). 최근 시장 점유율 숫자와 블랙웰 공급에서 MDS테크 몫도 못 찾았습니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1210Z.json","made":"2026-10-11"}}}
