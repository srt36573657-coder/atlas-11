0980,11120,10830,10700,10430,10560,10420,10450,10120,10020,10080,10180,10100,9820,9840,9800,9710,9650,9640,9660,9330,9660,9700,9720,9770,10020,10090,9990,9880,9720,9730,9360,9380,9480,9380,9570,9640,9790,9730,9980,10060,10070,9910,9980,10000,10020,9960,10200,9880,9850,9730,9680,9790,9820,9920,9660,9550,9570,9770,9730,9900,9860,9870,9960,10030,10040,10050,9970,9880,9820,9840,9870,9870,9960,10070,10070,10000,10020,10030,10060,9980,9960,9970,10040,10040,10020,10000,9980,9980,10000,9980,10090,9980,10000,10010,10030,10020,9960,9940,9950,10000,9990,9980,9960,9960,9970],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[3382,3589,3656],"op":[388,436,468],"net":[166,203,237],"roe":[8.38,9.64,11.36],"debt":[263.66,223.28,252.91]},"per":6.52,"pbr":0.78,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[3382,3589,3656,null],"baseYear":"2025","baseRev":3656,"ind":{"name":"물류·운송","n":25,"rank":15,"share":0.6,"near":6,"gap12":2.41,"size":"rev","me":3656},"top":[["현대글로비스",295664,"086280"],["CJ대한통운",122847,"000120"],["한진",30649,"002320"],["롯데렌탈",29188,"089860"],["세방",12418,"004360"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":0.98,"mid":1.1,"hi":1.22,"t":"2026년 2분기 매출이 2분기로는 가장 커, 2027년도 조금 늘까요?","g":"아주 높다"},"3":{"lo":0.93,"mid":1.17,"hi":1.44,"t":"정부 · 공공기관이 전기차를 늘리면 렌터카 일감도 조금씩 늘지 않을까요?","g":"높다"},"5":{"lo":0.88,"mid":1.24,"hi":1.65,"t":"큰 렌터카 · 금융 회사와 다퉈 빨리 크기는 어려운 쪽에 가깝습니다.","g":"높다"},"10":{"lo":0.78,"mid":1.38,"hi":2.1,"t":"차를 사기보다 빌려 타는 흐름이 이어지면 천천히 크는 쪽입니다.","g":"높다"}},"brk":"나라장터 '최우수' 평가가 끊기고 정부 · 공공기관 주문이 줄면 이 이야기는 아래로 틀립니다.","teams":{"google":"매출은 2023년 3,382억 → 2024년 3,589억 → 2025년 3,656억 원으로 천천히 늘었고, 2025년 영업이익은 468억 원입니다.","apple":"2025년 매출 3,656억 원 가운데 렌터카가 3,259억 원이고, 나라장터 평가에서 렌터카가 8년 내리 '최우수'를 받았습니다.","claude":"현대캐피탈 같은 큰 금융 회사가 장기 렌터카를 늘리면, 몫이 작은 레드캡투어는 값 다툼에 밀리지 않을까요?"},"rivals":[{"name":"롯데렌탈(롯데렌터카)","where":"국내","note":"렌터카 시장 1위(2024년 3분기 몫 20.8%)로, 단기·장기 렌터카에서 다툰다.","url":"https://www.sidae.com/article/2025031113441961822"},{"name":"SK렌터카","where":"국내","note":"렌터카 시장 2위(2024년 3분기 몫 15.7%)로, 단기·장기 렌터카에서 다툰다.","url":"https://www.sidae.com/article/2025031113441961822"},{"name":"현대캐피탈","where":"국내","note":"캐피탈(차 금융) 회사로 렌터카 몫 3위(2024년 3분기 12.8%)이며, 장기 렌터카에서 다툰다.","url":"https://www.sidae.com/article/2025031113441961822"}],"sells":"회사와 정부·공공기관에 차를 빌려주는 렌터카가 매출 대부분이다(2025년 매출 3,656억 원 가운데 렌터카 3,259억 원). 나머지는 회사 출장을 대신 챙겨 주는 여행 일로, 직원의 비행기·호텔 예약부터 비용 정산까지 맡는다(여행 397억 원). 손님은 회사(법인)와 정부·공공기관이고, 여행 쪽은 2차전지·석유화학·반도체 회사 출장이 기사에 나온다.","why":"정부 물건을 사는 온라인 장터(나라장터) 평가에서 렌터카는 2018~2025년 8년 내리 '최우수' 등급을 받았다. 차와 출장을 한 회사에 함께 맡길 수 있고, 차량 관리 서비스(RMS)와 전기차 배터리 관리(B-라이프케어)도 붙여 준다. 약점은 몸집이다. 렌터카 1·2위 롯데렌탈·SK렌터카와 큰 캐피탈(차 할부·대출 회사)들이 시장을 크게 나눠 갖고, 이익은 중고차 판매와 이자 비용에 흔들린다(2025년 4분기에는 중고차 판매가 줄고 성과급 같은 한 번 드는 비용이 겹쳐 렌터카 이익이 절반 넘게 줄었다).","market":"차를 사지 않고 빌려 타는 렌터카 시장은 커지고, 리스(빌려 쓰는 금융 상품) 시장은 2022년 14조7,000억 원에서 2024년 12조8,000억 원으로 줄었다는 기사가 있다. 정부·공공기관이 전기차 같은 친환경차를 늘리면서 이 회사 차 가운데 전기차 몫도 커졌다. 출장 쪽은 반도체·K-뷰티·K-푸드 회사들의 해외 출장이 늘었지만, 중동 전쟁 때문에 일부 단체 행사는 취소됐다.","events":"2025년 5월 세계적인 출장 관리 회사 아멕스 GBT의 한국 협력 손님을 레드캡투어로 옮겨 모으는 일을 마쳤다. 2026년 1월 공정거래위원회가 렌터카 1·2위 롯데렌탈과 SK렌터카의 합병을 막았다. 2026년 2분기에는 매출 982억 원·영업이익 157억 원으로 2분기 기준 가장 큰 실적을 냈고, 6월에는 국내 여행업계 처음으로 온실가스 줄이기 목표 승인(SBTi)을 받았다.","facts":[{"text":"2025년 매출은 3,656억 원, 영업이익은 468억 원이었다. 렌터카가 매출 3,259억 원을 냈고, 회사와 정부·공공기관 손님을 늘리며 장기 계약을 따내는 데 힘썼다. 여행은 매출 397억 원으로, 2차전지·석유화학 큰 손님의 출장이 줄어 매출이 조금 줄었다.","url":"https://core.asiae.co.kr/article/2026021214391908806","date":"2026-02-12","chk":"맞음"},{"text":"한국자동차대여사업조합연합회 자료로 2024년 3분기 렌터카 시장 몫은 롯데렌탈 20.8%, SK렌터카 15.7%, 현대캐피탈 12.8%, 하나캐피탈 6.2% 순이었다.","url":"https://www.sidae.com/article/2025031113441961822","date":"2025-03-12","chk":"맞음"},{"text":"2026년 1월 공정거래위원회가 렌터카 1·2위 롯데렌터카와 SK렌터카의 합병을 허락하지 않았다. 둘을 합친 몫은 장기 렌터카에서 38.3%였고, 나머지는 대부분 몫이 1%도 안 되는 작은 업체라고 기사는 전했다.","url":"https://www.hankyung.com/article/202601262773i","date":"2026-01-26","chk":"맞음"},{"text":"조달청 나라장터 계약 이행 평가에서 렌터카는 2018~2025년 8년 내리 '최우수' 등급을 받았다. 출장·숙박 서비스도 2022년 등록한 뒤 3년 내리 '최우수'였다.","url":"https://traveli.net/traveli/news-11773","date":"2025-03-11","chk":"맞음"},{"text":"아멕스 GBT가 세계에서 회사를 사고 합치는 과정에서 한국 협력사가 나뉘었는데, 2025년 이를 레드캡투어로 모았고 5월에 손님 옮기기를 마쳤다. 아멕스 GBT 회원 회사에서 나오는 매출도 늘었다.","url":"https://biz.newdaily.co.kr/site/data/html/2025/08/07/2025080700251.amp.html","date":"2025-08-07","chk":"맞음"},{"text":"2026년 2분기 매출은 982억 원, 영업이익은 157억 원으로 2분기 기준 가장 많았다. 정부·공공기관의 친환경차 주문이 늘어 전기차 몫이 16.3%에서 19.1%로 커졌고, 6월에는 국내 여행업계 처음으로 온실가스 줄이기 목표 승인(SBTi)을 받았다.","url":"https://view.asiae.co.kr/article/2026080615575037037","date":"2026-08-06","chk":"맞음"}],"unknown":"렌터카 시장에서 이 회사의 몫(%)과 순위, 보유 차량 수의 최근 숫자는 못 찾았다(2010년 기사에는 차량 수 5위로 나온다). 회사 출장 대행 시장의 전체 크기와 회사별 몫도 못 찾았다. 2026년 매출에 대한 증권사 평균치는 없다. 아멕스 GBT와의 계약 기간·조건, 나라 밖 경쟁 회사는 확인하지 못했다.","webFacts":6,"file":"reports/atlas11/t365/grow/stories-20261014T0826Z.json","made":"2026-10-14"}}}
