000,2880,2945,3025,3020,3025,3030,3010,3050,3085,3115,3080,3030,3075,3035,3060,3060,3000,3010,3015,3020,3000,3020,3015,3010,2970,2970,2985,2990,2970,2970,2975,2925,2930,2930,2925,2935,2930,2915,2895,2895,2920,2915,2915,2910,2915,2930,2895,2935,2890,2855],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[4906,4205,3877],"op":[-135,216,109],"net":[90,96,117],"roe":[2.12,2.3,3.15],"debt":[118.89,114.27,139.62]},"per":7.11,"pbr":0.17,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[4906,4205,3877,null],"baseYear":"2025","baseRev":3877,"ind":{"name":"정유·가스","n":14,"rank":8,"share":0.1,"near":0,"gap12":1.53,"size":"rev","me":3877},"top":[["SK",1227033,"034730"],["SK이노베이션",802961,"096770"],["S-Oil",342470,"010950"],["GS",251841,"078930"],["SK디스커버리",101640,"006120"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.7,"mid":0.91,"hi":1.15,"t":"2026년 1분기에도 8.5% 줄어 2027년도 작은 쪽에 가깝습니다.","g":"낮다"},"3":{"lo":0.6,"mid":0.88,"hi":1.25,"t":"이자가 연 20% 이내로 묶여 빌려주는 일이 크게 늘기 어려울까요?","g":"낮다"},"5":{"lo":0.52,"mid":0.86,"hi":1.36,"t":"기름 값에 따라 기름 판매 매출이 크게 오르내리지 않을까요?","g":"낮다"},"10":{"lo":0.4,"mid":0.85,"hi":1.55,"t":"전기차가 늘면 기름 판매가 줄어 10년 뒤는 더 작지 않을까요?","g":"낮다"}},"brk":"기름 값이 크게 뛰거나 빌려주는 돈을 다시 크게 늘리면 매출이 범위 위로 갈 수 있습니다.","teams":{"google":"매출이 2023년 4,906억 원에서 2025년 3,877억 원으로 줄었고, 2026년 증권사 평균치는 없습니다.","apple":"신용대출을 최대 3,000만 원까지 연 20% 이내 이자로 내주고, 주유소 등에서 기름도 팝니다.","claude":"순이익은 2023년 90억 원에서 2025년 117억 원으로 늘어, 덜 남는 매출을 일부러 줄인 것이라면 우리가 너무 어둡게 본 셈이 아닐까요?"},"rivals":[{"name":"HD현대오일뱅크","where":"국내","note":"주유소에 기름을 파는 큰 정유사로 기름 판매에서 같은 판에 있고, 리드코프 회사 소개 페이지에 비슷한 회사로 올라 있다.","url":"https://emis.cn/php/company-profile/KR/The_LeadcorpInc_en_1651625.html"},{"name":"대성산업","where":"국내","note":"기름 · 가스 판매로 다투는 회사로, 리드코프 회사 소개 페이지에 비슷한 회사로 올라 있다.","url":"https://emis.cn/php/company-profile/KR/The_LeadcorpInc_en_1651625.html"},{"name":"OK저축은행","where":"국내","note":"서민 · 신용이 낮은 사람에게 개인 신용대출을 내주는 일로 다툰다.","url":"","chk":{"v":"기사로 확인","url":"https://www.kukinews.com/article/view/kuk202306230110"}}],"sells":"두 가지 일로 돈을 번다. 하나는 서민 등 개인에게 돈을 빌려주는 대부(소비자 금융) 일로, 신용대출을 최대 3,000만 원까지 연 20% 이내 이자로 내준다. 다른 하나는 주유소 등에서 기름을 파는 유류 사업이다.","why":"대부 쪽은 오래된 상장 대부업체로 '서민금융 우수 대부업자'로 소개된 곳이고, 본점 · 지점과 TV 광고 · 인터넷으로 손님을 모아 왔다(2011년 기사: 새 영업의 80% 넘게가 이런 길). 약점은 빌려줄 때 받는 이자가 연 20% 이내로 묶여 있고, 회사 전체 매출이 2023년 4,906억 원에서 2025년 3,877억 원으로 해마다 줄었다는 점이다.","market":"회사 매출은 2023년 4,906억 원, 2024년 4,205억 원, 2025년 3,877억 원으로 줄었고, 2026년 1분기에도 8.5% 줄었다고 적혀 있다. 대부 시장과 기름 판매 시장이 지금 어떻게 움직이는지는 기사로 확인하지 못했다.","events":"2025~2026년의 투자 · 인수 · 새 사업 · 규제 · 소송 같은 큰 일은 찾지 못했다(검색 한도를 다 써 기사를 더 찾지 못함). 확인된 것은 2026년 1분기 매출이 8.5% 줄었다는 기록뿐이다.","facts":[{"text":"리드코프의 주된 일은 주유소(기름 판매)와 소비자 금융(개인에게 돈을 빌려주는 일)으로 분류돼 있다. 1977년 9월 19일 세워졌고, 2025년 직원은 240명이며, 자회사로 Nr Capital이 올라 있다. 2026년 1분기 매출은 8.5% 줄었다고 적혀 있다.","url":"https://emis.cn/php/company-profile/KR/The_LeadcorpInc_en_1651625.html","date":"2026-07-17","chk":"맞음"},{"text":"리드코프는 '서민금융 우수 대부업자'로 소개됐고, 신용대출을 최대 3,000만 원까지 연 20% 이내 이자로 내준다. 처음 빌리는 사람은 돈 쓸 곳이 적힌 원본 서류를 들고 본점이나 지점을 찾아야 한다.","url":"https://www.banksalad.com/articles/대부-체크리스트-대부업체-분석","date":"2024-01-02","chk":"맞음"},{"text":"2014년 기사에서 리드코프는 국내에서 하나뿐인 상장 대부업체로 소개됐다. 2011년 앤알캐피탈을 사들였고, 앤알캐피탈을 통해 아이루리아대부도 사들여 몸집을 키웠다.","url":"https://www.etoday.co.kr/news/view/901191","date":"2014-04-15","chk":"맞음"},{"text":"2011년 기사에서 대부업계 1위는 러시앤캐시, 2위는 산와대부였고 리드코프는 같은 업종의 대부업체로 소개됐다. 리드코프는 새 영업의 80% 이상이 TV 광고 · 인터넷으로 스스로 찾아온 손님에게서 나온다는 분석이 실렸다.","url":"https://www.mt.co.kr/stock/2011/11/07/2011110716321053660","date":"2011-11-07","chk":"맞음"}],"unknown":"대부와 유류 사업 각각의 매출 몫, 빌려준 돈의 규모(대출 잔액)와 지금의 대부업계 순위, 주유소 수와 기름 판매량, 어느 정유사 기름을 파는지는 찾지 못했다. 기본 자료의 주요 제품 칸에 적힌 '화공약품운반'을 지금도 하는지 확인하지 못했다. 2025~2026년 기사는 하나도 찾지 못해, 사실 넷 가운데 둘은 2011년 · 2014년 기사다. 2011년 대부업계 1 · 2위였던 러시앤캐시 · 산와대부가 지금도 새로 돈을 빌려주는지는 확인하지 못했다. 회사 누리집(leadcorp.co.kr)과 이투데이 검색 쪽은 열기 허락이 나지 않았고, 비즈워치 기사는 요청 제한으로 열지 못했다. 검색 6번 가운데 2번은 요청 형식 오류로 결과가 없었다. 맞수 가운데 저축은행 두 곳은 기사로 확인하지 못했고, HD현대오일뱅크 · 대성산업은 회사 소개 페이지의 '비슷한 회사' 목록에서만 봤다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261014T0826Z.json","made":"2026-10-14"}}}
