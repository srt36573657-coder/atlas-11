,34289],"baseYear":"2025","baseRev":33478,"ind":{"name":"석유화학","n":27,"rank":6,"share":3.1,"near":4,"gap12":2.49,"size":"rev","me":33478},"top":[["LG화학",459322,"051910"],["롯데케미칼",184830,"011170"],["KG케미칼",91016,"001390"],["금호석유화학",69151,"011780"],["DL",53267,"000210"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.81,"mid":0.99,"hi":1.18,"t":"2027년 같은 울산에서 S-OIL 큰 설비가 돌면 값이 눌리지 않을까요?","g":"반반"},"3":{"lo":0.68,"mid":0.97,"hi":1.32,"t":"나라 전체가 에틸렌 설비를 줄이는 판이라 제자리 쪽에 가깝습니다.","g":"반반"},"5":{"lo":0.65,"mid":1.0,"hi":1.45,"t":"울산 재편 결론에 따라 공장이 줄거나 커져 갈래가 넓은 쪽에 가깝습니다.","g":"반반"},"10":{"lo":0.6,"mid":1.07,"hi":1.7,"t":"분리막 원료 말고는 범용 제품이라 크게 크긴 어렵지 않을까요?","g":"반반"}},"brk":"울산 재편에서 공장을 크게 줄이거나, 거꾸로 이웃 설비를 사들이는 일.","teams":{"google":"2025년 매출은 약 20% 늘었지만, 2026년 증권사 평균치는 1.02배로 제자리입니다.","apple":"배터리 분리막용 HDPE 세계 1위(60%)이고, 가동률 95%로 이웃보다 높았습니다.","claude":"이미 공장을 95% 돌려 물량을 더 늘릴 자리가 적은 쪽에 가깝습니다."},"rivals":[{"name":"LG화학","where":"국내","note":"에틸렌·폴리에틸렌 같은 범용 제품을 두고 다툼","url":"https://v.daum.net/v/20250825173339562"},{"name":"롯데케미칼","where":"국내","note":"범용 폴리에틸렌·폴리프로필렌을 두고 다툼","url":"https://v.daum.net/v/20250825173339562"},{"name":"SK지오센트릭","where":"국내","note":"같은 울산 NCC(연 66만t)로 비슷한 제품을 만들고 설비 재편도 함께 논의함","url":"https://news.mtn.co.kr/news-detail/2026072211512226999"},{"name":"S-OIL","where":"국내","note":"울산 샤힌 설비(에틸렌 연 180만t)를 2027년 초 가동할 예정이라 물량이 크게 늘어남","url":"https://news.mtn.co.kr/news-detail/2026072211512226999"}],"sells":"울산 NCC(나프타를 쪼개 에틸렌·프로필렌을 만드는 공장)에서 원료를 만들고, HDPE(포장재·파이프·배터리 분리막용 폴리에틸렌)와 PP(자동차 범퍼·건자재용)를 팝니다. 손님은 플라스틱 가공 회사와 배터리 분리막 회사입니다.","why":"배터리 분리막용 HDPE는 세계 1위(점유율 60%)라 분리막 회사들이 가장 많이 고르는 곳입니다. 공장 가동률이 높아(2025년 상반기 95%) 같은 범용 제품도 남보다 원가가 낮은 쪽에 가깝습니다.","market":"국내 에틸렌 생산(2024년 약 1,038만t)이 국내 수요(861만t)보다 많아 정부와 업계가 설비를 줄이는 판입니다. 분리막용 원료는 배터리 수요를 따라 움직입니다.","events":"2026년 7월 여수 NCC 감축(연 139만t) 계획은 정부 승인을 받았지만, 울산(대한유화·SK지오센트릭·S-OIL) 재편은 아직 결론이 없습니다. 2025년에는 대한유화가 SK지오센트릭 NCC 설비 인수를 논의한다고 알려졌습니다.","facts":[{"text":"배터리 분리막용 HDPE에서 세계 1위이고 점유율은 60%입니다.","url":"https://v.daum.net/v/20250825173339562","date":"2025-08-25"},{"text":"2025년 상반기 NCC 공장 가동률은 95%로, 경쟁사(70%대)보다 높았습니다.","url":"https://v.daum.net/v/20250825173339562","date":"2025-08-25"},{"text":"정부와 업계는 에틸렌 생산을 최대 25%(연 370만t) 줄이기로 했습니다.","url":"https://v.daum.net/v/20250825173339562","date":"2025-08-25"},{"text":"울산 재편 논의에서 대한유화(NCC 80만~90만t)는 설비 줄이기에 적극적이지 않은 것으로 알려졌고, 결론은 아직 나지 않았습니다.","url":"https://news.mtn.co.kr/news-detail/2026072211512226999","date":"2026-07-22"}],"unknown":"분리막용 HDPE를 사 가는 손님 회사 이름, 기사에서 직접 본 해외 경쟁 회사 이름, 울산 재편의 감축 규모와 결론은 못 찾았습니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
