215,4115,4140,3810,3625,3575,3810,3875,3985,4225,4500,4550,4640,4715,4730,4825,4825,4760,4800,5280,5370,5480,5860,6050,6160,5980,6550,6300,6120,6170,6290,6970,6700,7210,7160,7010,6600,6690,6950,6880,6900,6990,6840,6790,7490,8050,7390,7560,7630,7680,7440,7710],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[643,234,369],"op":[14,-107,41],"net":[0,-120,43],"roe":[-0.68,-32.45,14.03],"debt":[51.11,68.27,48.32]},"per":61.68,"pbr":3.45,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[643,234,369,null],"baseYear":"2025","baseRev":369,"ind":{"name":"반도체","n":49,"rank":40,"share":0.0,"near":7,"gap12":3.43,"size":"rev","me":369},"top":[["삼성전자",3336059,"005930"],["SK하이닉스",971467,"000660"],["SK스퀘어",104556,"402340"],["하나마이크론",15344,"067310"],["심텍홀딩스",15281,"036710"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.55,"mid":1.0,"hi":1.62,"t":"큰 사업 한두 건에 매출이 흔들려 2025년 언저리를 오가는 쪽에 가깝습니다.","g":"반반"},"3":{"lo":0.5,"mid":1.05,"hi":1.95,"t":"2024년에 매출이 3분의 1로 줄었듯 다시 크게 출렁이지 않을까요?","g":"반반"},"5":{"lo":0.45,"mid":1.1,"hi":2.3,"t":"아크 차단기 같은 새 쓰임이 자리 잡으면 조금 크는 쪽에 가깝습니다.","g":"반반"},"10":{"lo":null,"mid":null,"hi":null,"t":"? 자료 모자람 · 큰 손님과 매출이 흔들린 까닭을 몰라 갈래가 너무 넓습니다.","g":null}},"brk":"해마다 이어지는 큰 계약을 따내면 제자리라는 이 그림이 틀리게 됩니다.","teams":{"google":"매출이 2023년 643억 원, 2024년 234억 원, 2025년 369억 원으로 크게 흔들렸습니다. 2025년 영업이익은 41억 원으로 흑자로 돌아섰습니다.","apple":"전력선통신 칩 · 원격 검침 장치 · 와이파이 칩 · 전기 불꽃(아크)을 막는 차단기를 설계해 팝니다. 2025년 2월 'K사'에 아크 차단기를 혼자 대는 회사가 됐습니다.","claude":"손님 이름도 매출이 흔들린 까닭도 못 찾았으니 어느 해를 기준으로 그려도 틀리기 쉽지 않을까요?"},"rivals":[{"name":"에스프레시프(Espressif)","where":"중국","note":"가전 · 사물인터넷용 와이파이 칩을 싼 값과 많은 물량으로 다툼","url":""},{"name":"리얼텍(Realtek)","where":"대만","note":"와이파이 · 통신 칩을 값으로 다툼","url":""}],"sells":"전력선으로 통신하는 칩(PLC 칩)과 원격 검침 통신 장치(AMI 모뎀), 와이파이 칩, 디지털 방송 · 라디오(DMB · DAB) 수신 칩, 전기 불꽃(아크)을 막는 차단기를 설계해 팝니다. 손님 이름은 아크 차단기의 'K사' 말고는 확인하지 못했습니다.","why":"국내 표준에 맞춘 전력선통신 칩과 국내 첫 와이파이 칩(2015년 회사 설명) 같은 국내용 기술이 강점입니다. 약점은 큰 사업 한두 건에 따라 매출이 2023년 643억 원에서 2024년 234억 원으로 크게 흔들린다는 점입니다.","market":"전기 안전(아크 차단기)처럼 새 쓰임이 생기고 있지만, 시장 크기 숫자는 못 찾았습니다. 매출은 큰 손님의 사업 일정에 따라 해마다 들쭉날쭉합니다.","events":"2025년 2월 'K사'에 아크 차단기를 혼자 공급하는 업체가 되었습니다(기사 제목). 그 밖의 2025~2026년 기사 두 건은 유료라 내용을 못 봤습니다.","facts":[{"text":"1996년 세운 시스템 반도체 설계 회사이고 2009년 코스닥에 상장했다. PLC 칩 · AMI 모뎀, 와이파이 칩, DAB 칩, 사물인터넷 아크 안전 시스템을 하고 자회사 글로베인을 두고 있다.","url":"https://stockhub.kr/stock/052860","date":"날짜 표시 없음(2026-10-11 열람)"},{"text":"2025년 2월 17일 기사 제목은 '아이앤씨, K사향 아크 차단기 공급 솔벤더..삼성·SK·CJ 통해 역량 검증'이다.","url":"https://www.finance-scope.com/article/list/!아이앤씨테크놀로지","date":"2025-02-17"},{"text":"전력선통신 칩(PLC SoC)은 국내 표준(KS X ISO/IEC 12139-1)에 맞춘 고속 칩으로 자동 검침 · 조명 제어 · 주차 안내에 쓰인다.","url":"https://kidd.co.kr/news/182899","date":"2015-12-09"}],"unknown":"주요 손님 이름(한국전력인지 포함)과 2023년 매출이 컸다가 2024년 줄어든 까닭은 못 찾았습니다. 경쟁 회사가 적힌 기사도 못 찾아, 업계에 알려진 와이파이 칩 회사로 적었습니다.","webFacts":3,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
