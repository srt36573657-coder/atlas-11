40,1700,1633,1695,1580,1417,1433,1598,1660,1778,1831,1775,1715,1814,1814,1792,1801,1810,1738,1696,1716,1638,1638,1690,1709,1693,1698,1710,1710,1675,1651,1669,1671,1650,1650,1663,1652,1660,1703,1697,1678,1623,1604,1578,1548,1570,1579,1581,1655,1666,1663,1618,1633],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[962,1315,628],"op":[68,193,44],"net":[756,-208,265],"roe":[40.57,-9.21,11.34],"debt":[29.69,32.77,24.9]},"per":2.77,"pbr":0.43,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[962,1315,628,null],"baseYear":"2025","baseRev":628,"ind":{"name":"디스플레이 장비","n":13,"rank":10,"share":2.7,"near":6,"gap12":1.13,"size":"rev","me":628},"top":[["동아엘텍",5824,"088130"],["선익시스템",5158,"171090"],["AP시스템",4601,"265520"],["HB테크놀러지",1603,"078150"],["DMS",1555,"068790"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.55,"mid":1.0,"hi":1.8,"t":"매출이 반으로 준 까닭을 몰라 2027년도 2025년과 비슷한 쪽에 가깝습니다.","g":"반반"},"3":{"lo":0.45,"mid":1.1,"hi":2.1,"t":"삼성디스플레이가 다음 투자를 하면 다시 커지는 오르내림 판일까요?","g":"반반"},"5":{"lo":null,"mid":null,"hi":null,"t":"? 자료 모자람 — 경쟁 회사를 못 찾아 5년 뒤 판은 따지지 않았습니다.","g":null},"10":{"lo":null,"mid":null,"hi":null,"t":"? 자료 모자람 — 매출이 반으로 준 까닭도 몰라 갈래가 너무 넓습니다.","g":null}},"brk":"삼성디스플레이 주문이 끊기면 받쳐 줄 다른 손님이 보이지 않아 아래로 틀립니다.","teams":{"google":"매출은 2024년 1,315억원에서 2025년 628억원으로 반 넘게 줄었습니다. 2026년 증권사 평균치는 없습니다.","apple":"잉크젯 도포기 같은 패널 장비를 삼성디스플레이에 팝니다. 경쟁 회사 이름은 찾지 못했습니다.","claude":"2023년 잉크젯 장비 계약 145억원이 손님 요구를 못 맞춰 해지됐습니다. 기술로 앞선 회사로 보기는 어렵지 않을까요?"},"rivals":[],"sells":"디스플레이 제조 장비(잉크젯 도포기·조립기·검사기)와 반도체 계측 장비를 팝니다. 확인된 손님은 삼성디스플레이(베트남 법인 포함)입니다.","why":"삼성디스플레이(베트남 법인 포함)에 장비를 대 온 거래 이력이 있습니다. 약점은 2023년 QD-OLED TV용 잉크젯 장비 145억원 계약이 손님 요구를 다 못 맞춰 해지된 일입니다.","market":"디스플레이 장비 판은 패널 회사의 공장 투자에 따라 크게 오르내립니다. 이 회사 제품 판이 커지는지는 기사로 확인하지 못했습니다.","events":"2026년 7월 7일과 7월 23일에 공급 계약 공시가 있었으나 상대와 금액은 확인하지 못했습니다. 2026년 7월 8일 임시주주총회 결과 공시도 있었습니다.","facts":[{"text":"2026년 7월 7일과 7월 23일에 단일판매·공급계약 체결 공시를 냈습니다(상대와 금액은 이 쪽에 없음).","url":"https://m.irgo.co.kr/IR-COMP/297890/HB솔루션-IR-PAGE","date":"2026-07-23"},{"text":"삼성디스플레이 베트남법인과 빛샘을 막는 디스플레이 장비 대규모 수주 소식을 냈습니다.","url":"https://m.irgo.co.kr/IR-COMP/297890/HB솔루션-IR-PAGE","date":"2023-01-19"},{"text":"삼성디스플레이와 맺은 QD-OLED TV용 잉크젯 장비 145억원 계약이 해지됐고, 이 장비는 미국 캐티바와 협력해 공급하던 것입니다.","url":"https://www.smarttoday.co.kr/ko-kr/articles/37489","date":"2023-11-06"},{"text":"잉크젯 장비(컬러필터·박막 봉지·뒷공정용)와 반도체 계측 장비(나노마이스)를 만듭니다.","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/한화20211112HB솔루션.pdf","date":"2021-11-12"}],"unknown":"진짜 경쟁 회사 이름을 못 찾아, 판의 모양은 제품 구성으로 본 판단입니다. 2026년 7월 공급 계약의 상대·금액, 임시주주총회 안건, 2025년 매출이 줄어든 까닭도 못 찾았습니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1210Z.json","made":"2026-10-11"}}}
