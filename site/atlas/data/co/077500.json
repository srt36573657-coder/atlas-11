690,5390,5390,4850,4295,4275,4880,4960,5120,5420,5700,5530,5990,6260,7300,6630,6800,7550,7270,7800,7000,6890,7230,7090,7080,7210,7950,7660,7570,7280,7440,7170,7080,7040,7090,7010,6800,7200,7320,7620,8270,8320,8420,9150,9650,10030,10090,10620,10450,10150,9700,9960],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[6659,7105,7300],"op":[340,341,367],"net":[163,49,193],"roe":[6.91,2.37,8.61],"debt":[112.68,108.45,110.34]},"per":7.11,"pbr":0.78,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[6659,7105,7300,null],"baseYear":"2025","baseRev":7300,"ind":{"name":"반도체 부품","n":21,"rank":3,"share":11.1,"near":4,"gap12":1.29},"top":[["엠케이전자",14038,"033160"],["이수페타시스",10880,"007660"],["유니퀘스트",7300,"077500"],["해성디에스",6534,"195870"],["리노공업",3725,"058470"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.88,"mid":1.08,"hi":1.4,"t":"AI 서버를 들여와 파는 일이 늘면 조금 크는 쪽에 가깝습니다.","g":"높다"},"3":{"lo":0.8,"mid":1.13,"hi":1.6,"t":"매출이 4년째 7000억 원 안팎이라 빨리 크기 어렵지 않을까요?","g":"높다"},"5":{"lo":0.74,"mid":1.2,"hi":1.85,"t":"남의 제품을 파는 일이라 공급사가 판매권을 바꾸면 흔들리지 않을까요?","g":"높다"},"10":{"lo":0.6,"mid":1.32,"hi":2.4,"t":"같은 제품을 파는 유통 회사가 많아 천천히 크는 쪽에 가깝습니다.","g":"반반"}},"brk":"인텔이나 퀄컴 같은 큰 공급사가 판매권을 다른 유통 회사로 옮기면 매출이 크게 줄어듭니다.","teams":{"google":"매출이 2023년 6659억 원, 2024년 7105억 원, 2025년 7300억 원입니다. 2025년 영업이익은 367억 원으로 매출의 약 5%입니다.","apple":"인텔 · 퀄컴 · 리얼텍 · 온세미 반도체와 슈퍼마이크로 AI 서버를 들여와 국내 회사에 공급합니다. 보고서는 국내 비메모리 반도체 유통 1위권으로 소개합니다.","claude":"엔비디아 서버 공급을 2026년에 하겠다고 했지만 실제로 시작됐는지 못 찾았으니 크게 보기는 이르지 않을까요?"},"rivals":[{"name":"애로우 일렉트로닉스(Arrow Electronics)","where":"미국","note":"세계 큰 전자부품 유통사 — 같은 반도체 회사의 판매권과 손님을 두고 다툼","url":""},{"name":"에브넷(Avnet)","where":"미국","note":"세계 큰 반도체 유통사 — 한국 지사를 두고 같은 손님을 두고 다툼","url":""}],"sells":"인텔 · 퀄컴 · 리얼텍 · 온세미 같은 나라 밖 회사의 반도체를 들여와 국내 전자 · 통신 · 자동차 전장 · 장비 회사에 공급합니다. 슈퍼마이크로의 AI 서버도 들여와 국내에 공급합니다.","why":"여러 반도체 회사 제품을 한곳에서 받을 수 있어 고릅니다(국내 비메모리 유통 1위권). 약점은 남의 제품을 파는 일이라 공급사가 판매권을 바꾸면 흔들리고, 2025년 영업이익률이 약 5%로 남는 돈이 적습니다.","market":"매출이 2022년 7,295억원에서 2025년 7,300억원으로 거의 제자리입니다. 새 길은 AI 서버 유통으로, 2025년 9월 보고서는 4분기부터 서버용 반도체 공급이 늘기를 기대했습니다.","events":"2026년에 엔비디아가 자기 칩으로 만든 서버를 들여와 국내에 공급할 계획이라고 2025년 9월 밝혔습니다. 실제로 시작됐는지는 못 찾았습니다.","facts":[{"text":"LS증권 보고서는 이 회사를 국내 비메모리 반도체 유통 1위(국내 선두권)로 소개합니다.","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/250912%20%EC%9C%A0%EB%8B%88%ED%80%98%EC%8A%A4%ED%8A%B8_%EA%B8%B0%EC%97%85%EB%B8%8C%EB%A6%AC%ED%94%84.pdf","date":"2025-09-12"},{"text":"인텔 · 퀄컴 · 리얼텍 · 온세미 반도체를 유통하고, 슈퍼마이크로가 만든 서버를 들여와 국내에 공급합니다.","url":"https://www.finance-scope.com/article/view/scp202509170025","date":"2025-09-19"},{"text":"매출은 2022년 7,295억원 · 2024년 7,105억원이고, 영업이익은 같은 때 473억원에서 341억원으로 줄었습니다.","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/250912%20%EC%9C%A0%EB%8B%88%ED%80%98%EC%8A%A4%ED%8A%B8_%EA%B8%B0%EC%97%85%EB%B8%8C%EB%A6%AC%ED%94%84.pdf","date":"2025-09-12"},{"text":"슈퍼마이크로(SMC)의 국내 유통 파트너이며, 보고서는 그 가운데 유일한 상장사로 적습니다.","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/250912%20%EC%9C%A0%EB%8B%88%ED%80%98%EC%8A%A4%ED%8A%B8_%EA%B8%B0%EC%97%85%EB%B8%8C%EB%A6%AC%ED%94%84.pdf","date":"2025-09-12"}],"unknown":"기사에서 직접 본 경쟁 유통사 이름(적은 두 곳은 업계에 알려진 세계 유통사), 분야별 매출 비중, 손님 이름, 엔비디아 서버 유통이 실제로 시작됐는지.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
