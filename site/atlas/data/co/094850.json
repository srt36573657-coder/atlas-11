4140,3945,4020,4100,4090,4210,4235,4185,4175,4210,4235,4235,4155,4195,4020,4145,4140,4175,4340,4375,4435,4400,4450,4360,4365,4290,4210,4285,4290,4380,4440,4425,4435,4425,4425,4420,4425,4330,4300,4325,4360,4375,4345,4250,4250,4255,4200,4110,4100,4040,4130],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[687,808,921],"op":[64,20,98],"net":[72,31,108],"roe":[8.93,3.65,11.69],"debt":[69.63,78.13,72.45]},"per":4.92,"pbr":0.56,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[687,808,921,null],"baseYear":"2025","baseRev":921,"ind":{"name":"호텔·레저","n":18,"rank":15,"share":1.3,"near":4,"gap12":1.28,"size":"rev","me":921},"top":[["강원랜드",14767,"035250"],["파라다이스",11499,"034230"],["롯데관광개발",6534,"032350"],["하나투어",5869,"039130"],["골프존",4833,"215000"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":0.9,"mid":1.12,"hi":1.3,"t":"회사는 2026년 10% 넘게 늘리길 바라지만 조금 덜 크지 않을까요?","g":"높다"},"3":{"lo":0.82,"mid":1.2,"hi":1.55,"t":"유럽 여행에 강하지만 예약이 앱으로 옮겨 가 더디게 크지 않을까요?","g":"높다"},"5":{"lo":0.75,"mid":1.26,"hi":1.75,"t":"큰 여행사와 예약 앱 사이에서 몫을 지키며 조금씩 크는 쪽에 가깝습니다.","g":"높다"},"10":{"lo":0.6,"mid":1.36,"hi":2.2,"t":"중년 손님이 묶음 여행을 찾아도 10년 내내 빨리 크긴 어렵지 않을까요?","g":"반반"}},"brk":"해외여행을 막는 전염병이나 큰 사고가 다시 터지면 이 이야기는 아래로 틀립니다.","teams":{"google":"매출은 2023년 687억 원에서 2025년 921억 원으로 늘었지만 호텔 · 레저 18곳 가운데 15위(몫 1.3%)이고, 증권사 평균치는 없습니다.","apple":"유럽 패키지 비중이 15% 이상으로 큰 여행사들(7~8%)의 두 배쯤이고, 중간 값 이상 상품 '라르고'로 40~50대를 겨냥합니다.","claude":"여행 예약이 아고다 · 트립닷컴 같은 인터넷 예약 회사로 빠르게 옮겨 가고 있어, 지난 빠른 성장을 이어 그리면 너무 좋게 보는 셈입니다."},"rivals":[{"name":"하나투어","where":"국내","note":"업계 1위 패키지 여행사로, 같은 해외 패키지 손님을 두고 다툰다.","url":"https://www.news1.kr/amp/industry/hotel-tourism/6030444"},{"name":"모두투어","where":"국내","note":"업계 2위 패키지 여행사로, 같은 해외 패키지 손님을 두고 다툰다.","url":"https://www.news1.kr/amp/industry/hotel-tourism/6030444"}],"sells":"해외 패키지 여행 상품(비행기 · 숙소 · 일정을 한데 묶은 여행)과 항공권을 판다. 손님은 해외여행을 떠나는 개인이고, 대리점을 거치지 않고 손님에게 바로 파는 '직판' 여행사다. 중간 값 이상의 상품 '라르고'로 40~50대 손님을 겨냥한다.","why":"유럽 패키지 비중이 15% 이상으로 큰 여행사들(7~8%)의 두 배쯤이라, 남는 돈이 큰 유럽 여행에 강하다. 항공 좌석을 미리 통째로 사 두는 '하드블록'으로 붐비는 때에도 자리를 챙긴다. 약점은 큰 여행사 넷(빅4) 가운데 몸집이 가장 작고, 2019년 헝가리 부다페스트 유람선 사고 손해배상 소송이 아직 끝나지 않았다는 점이다.","market":"코로나 뒤 해외여행은 되살아났지만, 2025년 상반기에는 하나투어 · 모두투어 · 노랑풍선 매출이 줄 만큼 여행사 장사가 어려웠다. 중국이 한국인에게 비자 없이 들어오게 하면서 중국 여행 예약이 크게 늘었다. 자유여행과 휴대폰 예약이 늘어, 판이 여행사에서 인터넷 여행 예약 회사(아고다 · 트립닷컴 · 놀유니버스 등) 쪽으로 빠르게 옮겨 가고 있다.","events":"2025년 3월 이종혁 대표 혼자 이끄는 체제로 바뀌었고, 2026년 2월 기사에는 '최근 대표이사가 바뀌었다'는 회사 말이 실렸다. 2026년 3월부터 여행 앱 마이리얼트립에서도 이 회사 패키지 상품을 판다. 헝가리 유람선 사고 소송은 2심에서 모두 25억8500만원을 물어 주라는 판결이 나왔다.","facts":[{"text":"매출은 꾸준히 돈을 버는 패키지 여행 판매(여행알선)와 항공권 판매에서 나온다. 2024년 패키지 여행 판매 수입은 518억원으로 전년보다 19.1% 늘었고, 하드블록(미리 사 둔 항공권) 등 항공권 판매로 200억원을 벌었다. 회사 지분 42.1%는 삼천리자전거가 갖고 있다.","url":"https://dealsite.co.kr/articles/138584","date":"2025-03-21","chk":"맞음"},{"text":"2025년 상반기 매출은 434억원으로 약 3.19% 늘어, 여행업계 빅4 가운데 홀로 컸다. 같은 때 하나투어 · 모두투어 매출은 8.45% · 19.64%, 노랑풍선은 19.08% 줄었다. 회사는 유럽 패키지 비중이 15% 이상으로 큰 여행사(7~8%)의 두 배쯤인 점을 까닭으로 들었다.","url":"https://newstomato.com/ReadNews.aspx?no=1272787","date":"2025-08-28","chk":"맞음"},{"text":"2019년 헝가리 부다페스트 유람선 침몰 사고로 숨진 5명의 유가족 9명이 여행 상품을 만든 참좋은여행에 손해배상을 청구했다. 2심은 모두 25억8500만원을 물어 주라고 판결해 1심(29억8600만원)보다 4억여원 줄었고, 기사 당시 합의는 안 된 상태였다.","url":"https://newstomato.com/ReadNews.aspx?no=1272787","date":"2025-08-28","chk":"맞음"},{"text":"2025년 매출은 유럽 · 중국 여행 수요가 늘어 921억원으로 14.0% 늘었고, 영업이익은 20억원에서 98억원으로 늘었지만 보상비용 환입 같은 한 번뿐인 요인 덕이 컸으며, 회사는 2026년 매출을 10% 이상 늘리는 것을 목표로 한다.","url":"https://newstomato.com/ReadNews.aspx?no=1292090","date":"2026-02-23","chk":"맞음"},{"text":"여행 앱 마이리얼트립이 교원투어 · 참좋은여행 · 롯데관광 등 큰 여행사의 패키지 상품을 팔기 시작했다. 참좋은여행은 다낭 메리어트 리조트를 넣은 자유여행 상품을 낼 예정이라고 했다.","url":"https://news.mtn.co.kr/news-detail/2026032614000723476","date":"2026-03-26","chk":"맞음"}],"unknown":"2026년에 새로 바뀐 대표의 이름과 날짜를 못 찾았다. 2026년 1 · 2분기 실적 기사는 못 찾았다. 회사별 패키지 시장 몫(%) 숫자는 기사에 없었다. 2026년 2월 기사에 2025년 '대손충당금 환입 276억원'이란 숫자가 있으나 한 해 매출(921억원)에 견줘 너무 커서 다른 자료로 맞춰 보지 못해 쓰지 않았다. 2024년 하반기에 시작했다는 '신사업'이 무엇인지, 유람선 소송 2심의 날짜와 그 뒤 결과(대법원 · 합의)도 못 찾았다.","webFacts":5,"file":"reports/atlas11/t365/grow/stories-20261014T0826Z.json","made":"2026-10-14"}}}
