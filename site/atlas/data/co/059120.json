315,5310,5410,5910,5480,6540,6290,6090,5260,5850,6090,6250,6980,7020,6740,6880,7450,7530,7440,7570,7000,6840,6960,6400,6350,6650,6460,6490,6440,6510,6360,6160,6910,7140,7120,6980,7030,7040,6900,6690,7230,7120,7180,7260,7190,7310,7360,7470,7460,7360,7740,7940,8070,7420,7440],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[249,252,246],"op":[-9,-42,10],"net":[5,-28,8],"roe":[1.14,-6.84,2.05],"debt":[11.44,12.07,9.65]},"per":27.56,"pbr":3.15,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[249,252,246,null],"baseYear":"2025","baseRev":246,"ind":{"name":"반도체","n":49,"rank":43,"share":0.0,"near":7,"gap12":3.43,"size":"rev","me":246},"top":[["삼성전자",3336059,"005930"],["SK하이닉스",971467,"000660"],["SK스퀘어",104556,"402340"],["하나마이크론",15344,"067310"],["심텍홀딩스",15281,"036710"]],"story":{"shape":"다투는 곳이 많음","h":{"1":{"lo":0.86,"mid":1.1,"hi":1.38,"t":"반도체 장비 투자가 늘면 함께 늘어 조금 크는 쪽에 가깝습니다.","g":"높다"},"3":{"lo":0.78,"mid":1.14,"hi":1.6,"t":"매출이 3년째 250억 원 안팎이라 크게 늘기는 어렵지 않을까요?","g":"높다"},"5":{"lo":0.72,"mid":1.22,"hi":1.88,"t":"높은 사양 시장은 외국 회사들이 가지고 있어 위로 크기 어렵지 않을까요?","g":"높다"},"10":{"lo":0.58,"mid":1.35,"hi":2.55,"t":"공장 로봇이 새 손님이 되면 조금 더 크는 쪽에 가깝습니다.","g":"반반"}},"brk":"세메스 · 원익IPS 같은 장비 회사가 다른 회사 제어 칩으로 바꾸면 매출이 크게 줄어듭니다.","teams":{"google":"매출이 2023년 249억 원, 2024년 252억 원, 2025년 246억 원으로 제자리입니다. 빚은 자기 돈의 10%쯤으로 적습니다.","apple":"기계 속 모터를 정확히 움직이는 칩과 제어 장치를 세메스 · 원익IPS 같은 장비 회사와 삼성전자에 팝니다. 2012년 국내 모션 제어 몫 1위(33.08%)였습니다.","claude":"로봇이 새 길로 꼽히지만 2025~2026년 큰 계약은 찾지 못했으니 크게 보기는 이르지 않을까요?"},"rivals":[{"name":"커미조아","where":"국내","note":"장비용 모션 제어 보드로 국내 장비 회사 일감을 다툼","url":""},{"name":"니혼펄스모터(Nippon Pulse Motor)","where":"일본","note":"모터를 움직이는 모션 제어 칩으로 다툼","url":""},{"name":"ACS Motion Control","where":"기타","note":"높은 사양의 반도체 장비용 모션 제어기로 다툼","url":""}],"sells":"기계 속 모터를 정확히 움직이게 하는 칩(모션제어칩)과 그 칩을 넣은 모듈 · 제어 장치 · 로봇 제어기를 팝니다. 손님은 세메스 · 원익IPS 같은 반도체 · 디스플레이 장비 회사와 삼성전자(산업용 로봇 부품)입니다.","why":"칩부터 모듈 · 제어기 · 소프트웨어까지 한 회사가 다 대 주고, 2012년 국내 모션 제어 점유율 1위(33.08%)였습니다. 약점은 높은 사양 시장을 외국 회사들이 가지고 있고, 매출이 3년째 250억 원 안팎에 머문다는 점입니다.","market":"반도체 · 디스플레이 장비 투자가 늘면 함께 늘고, 줄면 함께 줄어듭니다. 공장 로봇이 새 수요로 꼽힙니다.","events":"2025~2026년 큰 일은 찾지 못했습니다. 그 앞에 2023년 11월 삼성전자에 산업용 로봇 부품을 처음 납품했고, 2024년 1월부터 본격 납품했습니다.","facts":[{"text":"2012년 산업 자동화용 모션 제어 국내 점유율 33.08%로 1위였고, 높은 사양 시장은 외국 회사들이 가지고 있었다.","url":"https://newstomato.com/ReadNews.aspx?no=376819","date":"2013-06-27"},{"text":"약 700곳에 납품하며, 주 손님은 삼성전자 · SK하이닉스 · LG디스플레이에 장비를 대는 세메스와 원익IPS다. 기사는 국내에서 유일하게 모션제어칩을 직접 설계한 곳이라고 적었다.","url":"https://view.asiae.co.kr/article/2022011011550926303","date":"2022-01-10"},{"text":"2023년 11월 삼성전자에 산업용 로봇 부품을 처음 납품했고, 2024년 1월부터 본격 납품했다.","url":"https://news.mtn.co.kr/news-detail/2024031813205775727/share-modal","date":"2024-03-18"}],"unknown":"2025~2026년 계약과 최근 점유율, 로봇 부품 매출 몫은 못 찾았습니다. 경쟁 회사가 적힌 기사도 못 찾아, 업계에 알려진 이름으로 적었습니다.","webFacts":3,"file":"reports/atlas11/t365/grow/stories-20261011T1019Z.json","made":"2026-10-11"}}}
