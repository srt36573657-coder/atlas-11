0,8530,8320,8230,8010,7580,7370,7190,7800,8150,8150,8100,8120,8240,8100,8110,8160,7570,7440,7280,7430,7440,7650,7560,7610,7620,7410,7290,7250,7230,7170,6550,6660,6670,6700,6610,6740,7190,6880,6860,6800,6990,7160,7300,7260,7800,7820,7980,8110,8020,8140,8070,8210,8250,8270],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[3071,1096,1555],"op":[728,-39,42],"net":[619,356,1422],"roe":[16.27,5.03,35.52],"debt":[39.92,45.17,32.51]},"per":1.37,"pbr":0.43,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[3071,1096,1555,null],"baseYear":"2025","baseRev":1555,"ind":{"name":"디스플레이 장비","n":13,"rank":5,"share":6.7,"near":2,"gap12":1.13},"top":[["동아엘텍",5824,"088130"],["선익시스템",5158,"171090"],["AP시스템",4601,"265520"],["HB테크놀러지",1603,"078150"],["DMS",1555,"068790"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":0.55,"mid":0.95,"hi":1.5,"t":"큰 일감 납품이 2027년 3월에 끝나 그 뒤 새 주문에 달린 쪽에 가깝습니다.","g":"반반"},"3":{"lo":0.4,"mid":0.9,"hi":1.65,"t":"중국 새 OLED 공장 짓기가 끝난 뒤라 일감이 줄어드는 때일까요?","g":"반반"},"5":{"lo":0.35,"mid":0.95,"hi":1.95,"t":"중국 현지 장비 회사가 자리를 넓히면 몫이 줄지 않을까요?","g":"반반"},"10":{"lo":0.3,"mid":1.0,"hi":2.5,"t":"오르내림을 몇 번 겪어도 지금과 비슷한 크기에 머무는 쪽에 가깝습니다.","g":"반반"}},"brk":"중국 패널 회사들이 씻는 장비를 중국 회사 것으로 바꾸면 이 이야기는 아래로 틀립니다.","teams":{"google":"매출은 2023년 3,071억 → 2024년 1,096억 → 2025년 1,555억원으로 크게 오르내렸습니다. 2026년 증권사 평균치는 없습니다.","apple":"패널을 약품으로 씻고 깎는 장비를 CSOT·HKC 같은 중국 회사와 LG디스플레이에 팝니다. 삼성디스플레이는 계열사 세메스 장비를 씁니다.","claude":"2024년엔 일감이 끝나 매출이 한 해 만에 3분의 1 남짓으로 줄었습니다. 같은 일이 되풀이되지 않을까요?"},"rivals":[{"name":"케이씨텍","where":"국내","note":"디스플레이 세정 장비","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/카카오페이20210802DMS.pdf"},{"name":"시바우라(Shibaura)","where":"일본","note":"디스플레이 세정 장비","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/카카오페이20210802DMS.pdf"},{"name":"에프엔에스테크","where":"국내","note":"중국에서 습식 장비로 일부 다툼","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/이베스트20200408에프엔에스테크.pdf"}],"sells":"디스플레이 패널을 만들 때 약품으로 씻고·현상하고·깎고·벗겨 내는 장비(습식 장비)를 팝니다. 사는 곳은 CSOT·HKC 같은 중국 패널 회사와 LG디스플레이입니다.","why":"삼성 계열 세메스를 빼면 OLED 세정 장비 세계 1위라는 평가가 있고(2021년 자료), 중국 패널 회사들과 오래 거래했습니다. 삼성디스플레이는 계열사 세메스 장비를 써서 이 회사 손님이 되기 어렵습니다.","market":"중국 패널 회사들이 8.6세대 OLED 공장을 지어(CSOT 광저우 약 6조원 · BOE 청두 630억위안) 일감이 늘었습니다. 공장 짓기가 끝나면 주문이 줄어드는, 오르내림이 큰 판입니다.","events":"2026년 6월 CSOT 광저우 8.6세대 OLED 라인 장비 677억원어치를 따냈습니다(2027년 3월까지 납품). 2026년 들어 CSOT·HKC에서 약 1,400억원을 수주했고, 6월 말 받아 둔 일감(수주잔고)은 1,758억원입니다.","facts":[{"text":"CSOT 광저우 T8 공장 8.6세대 OLED 라인에 677억원 규모 장비를 2027년 3월까지 납품하기로 했습니다.","url":"https://www.fnnews.com/news/202606291007280818","date":"2026-06-29"},{"text":"2026년 2분기 매출은 288억원으로 1년 전보다 19% 늘었고, 6월 말 수주잔고는 1,758억원입니다.","url":"https://www.fnnews.com/news/202608141317094130","date":"2026-08-14"},{"text":"CSOT가 약 6조원 규모 광저우 OLED 공장 장비 발주를 시작했고, 디엠에스가 OLED 습식 장비를 맡은 것으로 알려졌습니다.","url":"https://www.fnnews.com/news/202605110808320772","date":"2026-05-11"},{"text":"2020년 디스플레이 세정 장비 세계 몫은 30% 초반이었습니다.","url":"https://file.alphasquare.co.kr/media/pdfs/company-report/카카오페이20210802DMS.pdf","date":"2021-07-30"}],"unknown":"중국 현지 장비 회사 가운데 진짜 경쟁 회사 이름과 2025~2026년 세계 몫 숫자를 못 찾았습니다. 경쟁 회사 자료는 2020~2021년 것입니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1210Z.json","made":"2026-10-11"}}}
