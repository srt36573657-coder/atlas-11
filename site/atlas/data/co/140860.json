ev":[1448,1751,2056],"op":[276,385,422],"net":[246,428,345],"roe":[18.68,25.83,16.69],"debt":[40.55,45.98,55.44]},"per":93.97,"pbr":6.37,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[1448,1751,2056,2455],"baseYear":"2025","baseRev":2056,"ind":{"name":"전자장비","n":29,"rank":10,"share":2.1,"near":9,"gap12":2.71},"top":[["에스에이엠티",37566,"031330"],["대덕",13850,"008060"],["아이디스홀딩스",9081,"054800"],["켐트로닉스",6375,"089010"],["에스텍",4682,"069510"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":1.12,"mid":1.3,"hi":1.48,"t":"대표 말(2026년 2,500억 원 이상)대로면 2027년은 조금 더 큰 쪽입니다.","g":"아주 높다"},"3":{"lo":1.1,"mid":1.5,"hi":2.1,"t":"반도체 공장 투자가 쉬는 해가 오면 성장 속도도 함께 느려질까요?","g":"아주 높다"},"5":{"lo":1.1,"mid":1.7,"hi":2.75,"t":"반도체를 쌓아 붙이는 공정 측정 같은 새 쓰임이 판을 넓히는 쪽입니다.","g":"아주 높다"},"10":{"lo":1.15,"mid":2.15,"hi":4.3,"t":"1위지만 2위와 차이가 크지 않아, 10년 내내 빠르기는 어렵지 않을까요?","g":"아주 높다"}},"brk":"중화권 매출 41%가 규제나 투자 감소로 크게 줄면 성장이 꺾일 수 있습니다.","teams":{"google":"매출은 2023년 1,448억 원에서 2025년 2,056억 원으로 해마다 약 19% 늘었습니다.","apple":"원자현미경 세계 1위(21.7%)지만 브루커 · 옥스포드와 셋이 절반쯤을 나눕니다.","claude":"반도체 공장과 중화권에 기대는 몫이 커서 빠른 성장이 계속되기는 어렵지 않을까요?"},"rivals":[{"name":"브루커(Bruker)","where":"미국","note":"원자현미경 2위(2024년 점유율 15.8%) · 2022년까지 1위","url":"https://www.parksystems.com/content/dam/parksystems/investor/pdf/2025_4Q_파크시스템스%20IR%20자료_260317.pdf"},{"name":"옥스포드 인스트루먼츠(Oxford Instruments)","where":"유럽","note":"원자현미경 3위(2024년 점유율 14.3%)","url":"https://www.parksystems.com/content/dam/parksystems/investor/pdf/2025_4Q_파크시스템스%20IR%20자료_260317.pdf"},{"name":"KLA","where":"미국","note":"반도체 검사 · 계측 장비 세계 큰 회사 · 파크가 넓히려는 계측 판의 강자","url":"https://www.mt.co.kr/article/2026060213449659384"}],"sells":"아주 작은 바늘로 표면을 더듬어 나노 크기를 재는 원자현미경(AFM)을 만들어 팝니다. 반도체 공장(2025년 매출의 71%)과 대학 · 연구소(22%)가 삽니다.","why":"반도체 공장용 원자현미경에 강해 2022년 브루커를 제치고 세계 1위(2024년 점유율 21.7%)가 됐습니다. 약점은 반도체 투자에 많이 기대고, 중화권 매출이 41%라는 점입니다.","market":"회사 자료는 산업용 장비 수요로 원자현미경 판이 계속 커진다고 봅니다. 첨단 패키징 · 하이브리드 본딩 측정처럼 새 쓰임도 늘고 있습니다.","events":"과천에 연구 · 생산 · 사무를 합친 새 본사를 열었고 용인 · 의왕 부지도 확보했습니다. 광학 계측 회사 린시테크를 인수했고, 세계 최대 파운드리와 공급을 협의 중입니다(2026년 6월 기사).","facts":[{"text":"2025년 매출은 2,056억 원(+17%), 영업이익은 422억 원(이익률 21%)이다. 매출은 산업용 장비 71% · 연구용 22% · 서비스 6%, 지역은 중화권 41% · 미국 20% · 한국 13%이고, 사업보고서 제출일 기준 수주잔고는 882억 원이다.","url":"https://www.parksystems.com/content/dam/parksystems/investor/pdf/2025_4Q_파크시스템스%20IR%20자료_260317.pdf","date":"2026-03-17"},{"text":"2024년 원자현미경 점유율은 파크시스템스 21.7%, 브루커 15.8%, 옥스포드 인스트루먼츠 14.3%, 나머지 48.2%다(MarketsandMarkets 분석 등).","url":"https://www.parksystems.com/content/dam/parksystems/investor/pdf/2025_4Q_파크시스템스%20IR%20자료_260317.pdf","date":"2026-03-17"},{"text":"박상일 대표는 올해 2,500억 원 이상 매출은 무리가 없다고 말했다. 과천 신사옥(지상 15층 · 연면적 약 2만7천㎡)으로 생산을 늘렸지만 늘어나는 수요를 소화하기에 부족하다는 평가가 나온다.","url":"https://www.mt.co.kr/article/2026060213449659384","date":"2026-06-02"},{"text":"2022년 브루커를 밀어내고 원자현미경 시장 1위가 됐고, 이 시장은 약 10억 달러 규모다. 2025년 린시테크를 인수했고 계측 관련 M&A를 5곳 넘게 논의 중이다.","url":"https://www.ddaily.co.kr/page/view/2025041413510565105","date":"2025-04-14"}],"unknown":"주요 고객 회사 이름(기사에서 확인 못 함)과 원자현미경 시장이 해마다 얼마나 커지는지 숫자는 못 찾았습니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1210Z.json","made":"2026-10-11"}}}
