320,8150,8200,8550,8200,8190,8540,8440,8100,8070,7860,8290,8060,8050,7280,6780,6980,7750,8200,8300,8620,8550,8700,8850,9080,9050,8950,9150,8780,8460,8600,8500,8600,8970,8990,9040,9000,9010,9120,8870,8730,8840,8720,8620,8970,9040,9070,8990,9190,9250,9260,9270,9240,9360,9240,9410,9760,10350,10600,11170,11760,14670,13260],"jumps":[],"fin":{"years":["2023.12","2024.12","2025.12"],"rev":[280,580,651],"op":[-17,68,92],"net":[17,134,104],"roe":[0.97,7.94,6],"debt":[13.14,14.52,13.09]},"per":15.37,"pbr":0.72,"key":"op","grow":{"years":["2023","2024","2025","2026E"],"rev":[280,580,651,716],"baseYear":"2025","baseRev":651,"ind":{"name":"디스플레이 장비","n":13,"rank":9,"share":2.8,"near":6,"gap12":1.13,"size":"rev","me":651},"top":[["동아엘텍",5824,"088130"],["선익시스템",5158,"171090"],["AP시스템",4601,"265520"],["HB테크놀러지",1603,"078150"],["DMS",1555,"068790"]],"story":{"shape":"몇 곳이 나눔","h":{"1":{"lo":0.5,"mid":0.9,"hi":1.3,"t":"새 OLED 공장 장비 납품이 끝나 가서 2027년은 줄어드는 쪽에 가깝습니다.","g":"낮다"},"3":{"lo":0.4,"mid":0.85,"hi":1.6,"t":"2023년 매출이 2025년의 절반도 안 됐듯 크게 오르내리지 않을까요?","g":"낮다"},"5":{"lo":0.38,"mid":0.95,"hi":1.9,"t":"반도체 기판 장비가 디스플레이 빈자리를 메울지가 갈림길일까요?","g":"반반"},"10":{"lo":0.35,"mid":1.1,"hi":2.5,"t":"원익IPS 같은 큰 회사와 다퉈 몫을 크게 넓히긴 어렵지 않을까요?","g":"반반"}},"brk":"큰 입찰에서 원익IPS·고요에 잇달아 지면 이 이야기는 아래로 틀립니다.","teams":{"google":"매출은 2023년 280억원에서 2025년 651억원으로 두 배 넘게 늘었습니다. 빚은 자기 돈의 13% 남짓으로 적습니다.","apple":"OLED 패널을 높은 열로 굽는 장비를 LG디스플레이·BOE·CSOT에 팝니다. 큰 입찰에서는 원익IPS·일본 고요와 맞붙습니다.","claude":"평균치는 2026년 매출이 늘어도 영업이익은 92억원에서 55억원으로 준다고 봅니다. 값 싸움이 세진 탓일까요?"},"rivals":[{"name":"원익IPS","where":"국내","note":"BOE 8.6세대 열처리 장비 입찰에서 맞붙음","url":"https://m.etnews.com/20240823000166"},{"name":"고요","where":"일본","note":"BOE 8.6세대 열처리 장비 입찰에서 맞붙음","url":"https://m.etnews.com/20240823000166"}],"sells":"디스플레이 패널을 높은 열로 굽는 열처리 장비(OLED·LTPS용)를 팝니다. 사는 곳은 LG디스플레이와 BOE·CSOT 같은 중국 패널 회사이고, 자회사는 반도체 기판(FC-BGA)용 진공 라미네이터를 만듭니다.","why":"2010년에 8세대 산화물(옥사이드) TFT 열처리 장비를 세계 처음 개발·납품한 기술 이력이 있습니다. 큰 입찰에서는 원익IPS·일본 고요와 맞붙습니다.","market":"패널 회사들의 8.6세대 OLED 공장 투자(BOE 청두 등)로 일감이 생겼지만, 공장 투자에 따라 크게 오르내립니다. 반도체 기판 장비로 일을 넓히려 합니다.","events":"2025~2026년 큰 계약·공장 기사는 찾지 못했습니다.","facts":[{"text":"BOE 8.6세대 열처리 장비 3종(퍼니스·PI 경화·저온 평판 오븐) 입찰을 놓고 원익IPS·비아트론·일본 고요가 다투고 있었습니다(당시 낙찰 전).","url":"https://m.etnews.com/20240823000166","date":"2024-08-25"},{"text":"BOE 청두 8.6세대 OLED 공장(투자 630억위안)에 비아트론이 열처리 장비를 낼 것으로 예상됐습니다.","url":"https://v.daum.net/v/20240902150128379","date":"2024-09-02"},{"text":"2023년 상반기 매출은 플렉시블 디스플레이 52.4%, LTPS LCD 34.7%, 기타 12.9%였고, 그해 BOE향 206억원·CSOT향 60억원 수주를 공시했습니다.","url":"https://ssl.pstatic.net/imgstock/upload/research/company/1696983969373.pdf","date":"2023-10-11"},{"text":"2010년 8세대 산화물(옥사이드) TFT 열처리 장비를 세계 처음 개발·납품했습니다.","url":"https://newstomato.com/ReadNews.aspx?no=406490","date":"2013-10-07"}],"unknown":"2025~2026년 수주·계약 기사, 세계 몫 숫자, 반도체 장비 쪽 경쟁 회사 이름을 못 찾았습니다. 삼성전기와 유리기판용 글라스 본더를 함께 개발한다는 기사는 제목만 봤고 날짜와 본문은 확인하지 못했습니다.","webFacts":4,"file":"reports/atlas11/t365/grow/stories-20261011T1210Z.json","made":"2026-10-11"}}}
