#!/bin/sh
# 밀어 넣기 문(규칙 34 · 2026-10-08 01:31 「너 시스템으로 그짓 못하게 해」) — 화면 코드를 고치고 빠짐없이 도는 검사(full_check.mjs)를 안 돌렸으면 막는다
# 켜는 법(저장소마다 한 번): git config core.hooksPath scripts/atlas11/hooks
node scripts/atlas11/art_gate.mjs || { echo "밀어 넣기 막힘 — node scripts/atlas11/full_check.mjs 를 돌려 실패 0 결과를 함께 커밋하세요(규칙 34)"; exit 1; }
# 장부 문(2026-10-13 02:33 「뭘걸거야?」) — 틀림 장부 reports/atlas11/trust/ 는 새 파일만
node scripts/atlas11/trust_gate.mjs || { echo "밀어 넣기 막힘 — 틀림 장부를 지우거나 고쳤습니다. 되돌리고 새 틀림은 새 파일로 더하세요"; exit 1; }
# 얼굴 문(2026-10-13 03:38 「모든 흔적 다 지워」) — 지운 옛 사람 얼굴 그림이 다시 들어오면 막음
node scripts/atlas11/face_gate.mjs || { echo "밀어 넣기 막힘 — 지운 옛 얼굴 그림이 다시 들어 있습니다. 그 파일을 빼고 다시 밀어 넣으세요"; exit 1; }
# 커밋 번호 문(2026-10-13 12:3x · 틀림 장부 19번) — 기록 탭 줄의 커밋 번호가 저장소 줄기에 있어야 함(다시 쌓기 뒤 바뀐 번호를 막음)
node scripts/atlas11/changelog_commit_gate.mjs || { echo "밀어 넣기 막힘 — 기록 탭 커밋 번호가 저장소에 없습니다. 바뀐 번호로 고침 줄을 더하세요"; exit 1; }
